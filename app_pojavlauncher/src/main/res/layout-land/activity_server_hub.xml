<?xml version="1.0" encoding="utf-8"?><!-- ═══════════════════════════════════════════════════════════════════
  SERVER HUB — landscape.

  A phone on its side has ~380dp of height, so the portrait stack would leave
  about one card on screen. Here the chrome becomes a left rail (title, the
  live status line, the two actions, the servers.dat note) and the whole rest
  of the width is the card column — the artwork strips get real width, which
  is the one thing worth seeing in landscape.
═══════════════════════════════════════════════════════════════════════ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/hub_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_au_page"
    android:baselineAligned="false"
    android:fitsSystemWindows="true"
    android:orientation="horizontal">

    <!-- ── rail ─ -->
    <LinearLayout
        android:layout_width="216dp"
        android:layout_height="match_parent"
        android:background="@color/au_surface"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Same control as portrait: the activity wires hub_back unconditionally, so both
                 variants carry it. A page you can only leave with a system gesture is a page
                 that traps you when that gesture is off. -->
            <FrameLayout
                android:id="@+id/hub_back"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="9dp"
                android:background="@drawable/pe4_back_btn"
                android:clickable="true"
                android:contentDescription="@string/global_back"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/au_text" />
            </FrameLayout>

            <TextView
                android:id="@+id/hub_title"
                style="@style/AuHeroTitle"
                android:letterSpacing="0.02"
                android:text="@string/hub_title" />
        </LinearLayout>

        <TextView
            android:id="@+id/hub_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:includeFontPadding="false"
            android:lineSpacingExtra="1dp"
            android:maxLines="3"
            android:textColor="@color/au_text_dim"
            android:textSize="10.5sp"
            tools:text="Profile default · live status and one-tap join" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/hub_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:maxLines="2"
            android:text="@string/hub_status_idle"
            android:textColor="@color/au_text_dim"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hub_refresh"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_au_ghost"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:text="@string/hub_refresh"
                android:textColor="@color/au_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hub_add"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/mvs_btn_primary"
                android:clickable="true"
                android:drawablePadding="5dp"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:text="@string/hub_add"
                android:textColor="#141519"
                android:textSize="11sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_add_dark" />
        </LinearLayout>

        <TextView
            android:id="@+id/hub_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:maxLines="4"
            android:text="@string/hub_note"
            android:textColor="@color/au_text_faint"
            android:textSize="10sp" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/au_line" />

    <!-- ── card column ── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/hub_list"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:scrollbars="vertical" />
</LinearLayout>
