<?xml version="1.0" encoding="utf-8"?>
<!-- First-launch Runtime Forge — landscape setup experience. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_runtime_forge_page">

    <!-- Selection state -->
    <LinearLayout
        android:id="@+id/rs_select_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/rs_select_sidebar"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_runtime_forge_sidebar"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.16"
                android:text="RUNTIME FORGE"
                android:textColor="#9C9EA8"
                android:textSize="9sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/rs_brand_orbit"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_runtime_forge_orbit">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="J"
                    android:textColor="#F5F5F7"
                    android:textSize="29sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/rs_title"
                android:textColor="#F5F5F7"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/rs_summary"
                android:textColor="#898B95"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_runtime_forge_steps"
                android:orientation="vertical"
                android:padding="11dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="01  CHOOSE VERSIONS" android:textColor="#F0F0F3" android:textSize="9.5sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="02  DOWNLOAD SECURELY" android:textColor="#737580" android:textSize="9.5sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="03  READY TO PLAY" android:textColor="#737580" android:textSize="9.5sp" android:textStyle="bold" />
            </LinearLayout>

            <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

            <TextView
                android:id="@+id/rs_offline_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_runtime_forge_offline"
                android:padding="9dp"
                android:text="@string/rs_offline_note"
                android:textColor="#E6A6AB"
                android:textSize="9.5sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <Button
                android:id="@+id/rs_btn_install"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_runtime_forge_primary"
                android:letterSpacing="0.07"
                android:stateListAnimator="@null"
                android:text="@string/rs_install_cta"
android:textColor="#F1F1F4"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rs_btn_skip"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="@string/rs_skip"
                android:textColor="#777984"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="18dp"
            android:paddingEnd="22dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose your Java engines"
                android:textColor="#F3F3F6"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Recommended versions are selected automatically. You can install more than one runtime."
                android:textColor="#7F818B"
                android:textSize="10.5sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="13dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="10dp"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/rs_card_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <!-- Download/install state -->
    <LinearLayout
        android:id="@+id/rs_install_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/rs_install_sidebar"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_runtime_forge_sidebar"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start" android:letterSpacing="0.16" android:text="BUILDING RUNTIME DECK" android:textColor="#9C9EA8" android:textSize="9sp" android:textStyle="bold" />

            <FrameLayout
                android:layout_width="154dp"
                android:layout_height="154dp"
                android:layout_marginTop="25dp">
                <View android:id="@+id/rs_ring_halo" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_runtime_forge_halo" />
                <net.kdt.pojavlaunch.multirt.RuntimeRingView android:id="@+id/rs_ring" android:layout_width="match_parent" android:layout_height="match_parent" />
                <TextView android:id="@+id/rs_overall_percent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:textColor="#F5F5F7" android:textSize="25sp" android:textStyle="bold" tools:text="42%" />
            </FrameLayout>

            <TextView android:id="@+id/rs_overall_step" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="17dp" android:gravity="center" android:textColor="#F0F0F3" android:textSize="14sp" android:textStyle="bold" tools:text="Installing Java 17" />
            <TextView android:id="@+id/rs_status_line" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:textColor="#858792" android:textSize="10sp" tools:text="24 / 55 MB • 4.2 MB/s • 8s left" />
            <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <Button android:id="@+id/rs_btn_done" android:layout_width="match_parent" android:layout_height="46dp" android:background="@drawable/bg_runtime_forge_primary" android:stateListAnimator="@null" android:text="@string/rs_done_cta" android:textColor="#F1F1F4" android:textSize="11.5sp" android:textStyle="bold" android:visibility="gone" tools:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="22dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Installation pipeline" android:textColor="#F3F3F6" android:textSize="19sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Each runtime is downloaded, verified and unpacked in sequence." android:textColor="#7F818B" android:textSize="10.5sp" />
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="18dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fillViewport="false"
                android:overScrollMode="never"
                android:scrollbars="none">
                <LinearLayout android:id="@+id/rs_install_rows" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
