<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ── Default (Dark) ───────────────────────────────────── -->
    <style name="AppTheme" parent="@style/Theme.Material3.Dark.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@style/AppWindowAnimations</item>
        <!-- Transparent bars: no painted horizontal strip at the top edge. -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="colorBgApp">#0B0B0E</item>
        <item name="colorBgBottomBar">#0B0B0E</item>
        <item name="colorBgStatusBar">#0B0B0E</item>
        <item name="colorDivider">#1AFFFFFF</item>
        <item name="themeAccent">@color/premium_cyan</item>
        <item name="colorTextPrimary">@color/text_primary_white</item>
        <item name="colorTextSecondary">@color/text_secondary_light</item>
        <item name="bgMainDrawable">@drawable/bg_premium_cosmic_gradient</item>
        <item name="android:windowBackground">@drawable/bg_premium_cosmic_gradient</item>
        <!-- Explicit Material 3 palette: blocks its built-in #D0BCFF lavender fallback. -->
        <item name="colorPrimary">#FFFFFF</item>
        <item name="colorOnPrimary">#0D0D0D</item>
        <item name="colorPrimaryContainer">#FFFFFF</item>
        <item name="colorOnPrimaryContainer">#0D0D0D</item>
        <item name="colorSecondary">#D0D0D0</item>
        <item name="colorOnSecondary">#0D0D0D</item>
        <item name="colorSecondaryContainer">#25262D</item>
        <item name="colorOnSecondaryContainer">#FFFFFF</item>
        <item name="colorTertiary">#B8B8B8</item>
        <item name="colorOnTertiary">#0D0D0D</item>
        <item name="colorAccent">#D0D0D0</item>
        <item name="colorOnSurface">@color/text_primary_white</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_light</item>
        <item name="colorSurface">#141419</item>
        <item name="colorSurfaceVariant">#1B1B22</item>
    </style>
    <style name="AppTheme.Gradient">
        <item name="bgMainDrawable">@drawable/bg_gradient_default</item>
        <item name="android:windowBackground">@drawable/bg_gradient_default</item>
        <item name="colorBgBottomBar">@color/cu_bg_bottom_bar</item>
        <item name="colorBgStatusBar">@color/cu_bg_status_bar</item>
        <item name="colorAccent">#FFFFFF</item>
    </style>

    <!-- ── Dialogs ─────────────────────────────────────────── -->
    <!--
        CS alert dialog: every AlertDialog.Builder popup in the launcher
        (runtime select, confirmations, pickers…) gets this rounded graphite
        surface + the fade-scale pop animation — declared once, applied
        app-wide through alertDialogTheme below.
    -->
    <style name="CsDialogAnim">
        <item name="android:windowEnterAnimation">@anim/cs_dialog_in</item>
        <item name="android:windowExitAnimation">@anim/cs_dialog_out</item>
    </style>

    <style name="CsAlertDialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_cs_dialog</item>
        <item name="android:windowAnimationStyle">@style/DialogFadeScale</item>
        <item name="android:colorBackground">#15161B</item>
        <item name="colorSurface">#15161B</item>
        <item name="android:textColorPrimary">#F2F3F6</item>
        <item name="android:textColorSecondary">#B9BEC9</item>
        <item name="colorPrimary">#E6E8EE</item>
        <item name="colorAccent">#E6E8EE</item>
    </style>

    <style name="DialogFadeScale" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/fade_scale_in</item>
        <item name="android:windowExitAnimation">@anim/fade_scale_out</item>
    </style>

    <!--
        One window motion for every popup surface: dialogs, pickers and sheets
        inherit the shared fade-scale spring pop instead of the platform default.
        Activity navigation is untouched — the open/close animations fall through
        to the system defaults declared by the base Animation style.
    -->
    <style name="AppWindowAnimations" parent="@android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/fade_scale_in</item>
        <item name="android:windowExitAnimation">@anim/fade_scale_out</item>
    </style>

