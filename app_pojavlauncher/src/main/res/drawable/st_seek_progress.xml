<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical">
        <shape android:shape="rectangle">
            <size android:height="3dp" />
            <corners android:radius="2dp" />
            <solid android:color="#2B2F38" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress" android:gravity="center_vertical">
        <clip><shape android:shape="rectangle"><size android:height="3dp" /><corners android:radius="2dp" /><solid android:color="#363A44" /></shape></clip>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical">
        <clip><shape android:shape="rectangle"><size android:height="3dp" /><corners android:radius="2dp" /><gradient android:angle="0" android:startColor="#8A909C" android:endColor="#E6E9EF" /></shape></clip>
    </item>
</layer-list>