<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="270"
                android:startColor="#222838"
                android:endColor="#181B24" />
            <stroke android:width="1.8dp" android:color="#E2E8F0" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#252B3A" />
            <stroke android:width="1.2dp" android:color="#4A536A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="270"
                android:startColor="#161922"
                android:endColor="#101219" />
            <stroke android:width="1.2dp" android:color="#252A36" />
        </shape>
    </item>
</selector>
