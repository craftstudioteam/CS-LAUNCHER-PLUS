<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#23262E" />
            <stroke android:width="1dp" android:color="#4A4F5A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="270" android:startColor="#1B1D23" android:endColor="#141519" />
            <stroke android:width="1dp" android:color="#2F323B" />
        </shape>
    </item>
</selector>
