<?xml version="1.0" encoding="utf-8"?>
<!-- The "selected file" hero row: silver ring + left accent, ripple on tap. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33C9CED8">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient android:angle="0" android:startColor="#23262E" android:endColor="#181A20" />
                    <stroke android:width="1.5dp" android:color="#C9CED8" />
                </shape>
            </item>
            <item android:left="0dp" android:right="0dp" android:top="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="15dp" />
                    <gradient android:angle="270" android:startColor="#12FFFFFF" android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
