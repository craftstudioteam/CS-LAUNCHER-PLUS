<?xml version="1.0" encoding="utf-8"?>
<!-- Floating label pill for top-toolbar icons (Req-10):
     obsidian capsule + platinum rim + violet underglow edge -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#F227272E"
                android:endColor="#F218181C" />
            <corners android:radius="999dp" />
            <stroke android:width="1dp" android:color="#3DFFFFFF" />
        </shape>
    </item>
    <!-- violet underglow hairline at the pill's bottom edge -->
    <item android:left="4dp" android:right="4dp" android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#00D0D0D0"
                android:centerColor="#A6D0D0D0"
                android:endColor="#00D0D0D0" />
            <corners android:bottomLeftRadius="999dp" android:bottomRightRadius="999dp" />
            <size android:height="2dp" />
        </shape>
    </item>
</layer-list>
