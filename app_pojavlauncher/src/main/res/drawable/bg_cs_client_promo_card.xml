<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#18202C"
                android:centerColor="#11161F"
                android:endColor="#0B0E16"
                android:type="linear" />
            <corners android:radius="22dp" />
            <stroke android:width="1.2dp" android:color="#62D99B" />
        </shape>
    </item>
    <item android:top="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="21dp" />
            <stroke android:width="0.6dp" android:color="#2E62D99B" />
        </shape>
    </item>
</layer-list>