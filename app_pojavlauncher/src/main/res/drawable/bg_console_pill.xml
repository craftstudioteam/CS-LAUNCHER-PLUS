<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed mini-pill the console shrinks into when hidden by the user. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#1E1E26"
        android:endColor="#131318"
        android:type="linear" />
    <corners android:radius="999dp" />
    <stroke android:width="1dp" android:color="#2D2D35" />
</shape>
