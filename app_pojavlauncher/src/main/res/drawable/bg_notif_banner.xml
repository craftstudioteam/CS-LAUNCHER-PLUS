<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom strip on the browse page: the one place we ask for notification
     permission, because that is where the progress bar the user is missing lives. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="0"
        android:startColor="#F2151A22"
        android:endColor="#F210131A" />
    <stroke android:width="1dp" android:color="#3322C9CB" />
    <corners android:radius="14dp" />
</shape>
