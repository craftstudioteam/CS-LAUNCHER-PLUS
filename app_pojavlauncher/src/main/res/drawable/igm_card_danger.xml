<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#3A1F23" />
            <stroke android:width="1dp" android:color="#E2545E" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="270" android:startColor="#25171A" android:endColor="#191215" />
            <stroke android:width="1dp" android:color="#5A2A31" />
        </shape>
    </item>
</selector>
