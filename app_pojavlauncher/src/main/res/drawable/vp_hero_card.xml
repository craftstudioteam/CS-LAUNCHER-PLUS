<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient android:angle="0" android:startColor="#F21E2027" android:endColor="#F216181D" />
            <stroke android:width="1dp" android:color="#2F323B" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <gradient android:angle="270" android:startColor="#14FFFFFF" android:endColor="#00FFFFFF" android:centerY="0.25" android:centerColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
