<?xml version="1.0" encoding="utf-8"?>
<!-- Resource detail — "INSTALLED / UNINSTALL" dock button. Graphite family: a
     lighter silver than the primary button so the state reads at a glance
     without leaving the grey palette. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33000000">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="0" android:startColor="#F1F3F7" android:endColor="#C9CED8" />
            <stroke android:width="1dp" android:color="#FFFFFF" />
        </shape>
    </item>
</ripple>
