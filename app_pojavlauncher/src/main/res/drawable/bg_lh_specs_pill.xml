<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted dark-graphite glass surface for Home screen profile specs pill -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#E6161822"
                android:endColor="#E6101219" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#2A2E3D" />
        </shape>
    </item>
</layer-list>
