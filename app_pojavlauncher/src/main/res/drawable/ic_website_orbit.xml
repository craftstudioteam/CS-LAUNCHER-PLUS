<?xml version="1.0" encoding="utf-8"?>
<!-- Website glyph v2 — globe with meridians inside an orbit ring -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <!-- outer globe -->
    <path
        android:pathData="M12,3.6 A8.4,8.4 0 1,0 12,20.4 A8.4,8.4 0 1,0 12,3.6 Z"
        android:strokeColor="#FFFFFFFF" android:strokeWidth="1.6" android:fillColor="#00000000"/>
    <!-- vertical meridian ellipse -->
    <path
        android:pathData="M12,3.6 C8.9,5.9 8.9,18.1 12,20.4 C15.1,18.1 15.1,5.9 12,3.6 Z"
        android:strokeColor="#B3FFFFFF" android:strokeWidth="1.3" android:fillColor="#00000000"/>
    <!-- equator -->
    <path
        android:pathData="M3.8,12 L20.2,12"
        android:strokeColor="#B3FFFFFF" android:strokeWidth="1.3"/>
    <!-- upper / lower latitude arcs -->
    <path
        android:pathData="M5.2,8.2 C7.4,9.3 16.6,9.3 18.8,8.2"
        android:strokeColor="#66FFFFFF" android:strokeWidth="1.1" android:fillColor="#00000000"/>
    <path
        android:pathData="M5.2,15.8 C7.4,14.7 16.6,14.7 18.8,15.8"
        android:strokeColor="#66FFFFFF" android:strokeWidth="1.1" android:fillColor="#00000000"/>
    <!-- orbit satellite dot -->
    <path
        android:pathData="M19.9,5.4 A1.3,1.3 0 1,0 19.9,8.0 A1.3,1.3 0 1,0 19.9,5.4 Z"
        android:fillColor="#FFFFFFFF"/>
</vector>
