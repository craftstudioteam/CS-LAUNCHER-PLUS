<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient android:angle="270" android:startColor="#FF1B1D23" android:endColor="#FF0E0F13" />
            <stroke android:width="1dp" android:color="#3B4049" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <gradient android:angle="270" android:startColor="#12FFFFFF" android:endColor="#00FFFFFF" android:centerY="0.2" android:centerColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
