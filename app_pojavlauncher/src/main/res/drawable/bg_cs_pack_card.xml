<?xml version="1.0" encoding="utf-8"?>
<!-- Cursor Studio v4 — pack card (idle) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#26FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:angle="270" android:startColor="#191B21" android:endColor="#121318" />
            <stroke android:width="1dp" android:color="#262932" />
        </shape>
    </item>
</ripple>
