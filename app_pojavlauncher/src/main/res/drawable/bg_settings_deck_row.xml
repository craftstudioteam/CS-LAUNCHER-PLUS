<?xml version="1.0" encoding="utf-8"?>
<!-- Aurora settings deck row — deep glass card, teal-wash top light, 22dp radius. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#2E62D99B">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <gradient android:angle="270" android:startColor="#202A33" android:endColor="#151B22" />
                    <stroke android:width="1.2dp" android:color="#62D99B" />
                </shape>
            </item>
            <item>
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <corners android:radius="22dp" />
                            <gradient android:angle="270" android:startColor="#1A202B" android:endColor="#10141C" />
                            <stroke android:width="1dp" android:color="#26303B" />
                        </shape>
                    </item>
                    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="26dp">
                        <shape android:shape="rectangle">
                            <corners android:topLeftRadius="21dp" android:topRightRadius="21dp" />
                            <gradient android:angle="270" android:startColor="#0D62D99B" android:endColor="#0062D99B" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </selector>
    </item>
</ripple>