<?xml version="1.0" encoding="utf-8"?>
<!-- Profile hero backdrop — deep violet-grey glass with soft bottom fade. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="135" android:startColor="#1C1730" android:centerColor="#16121F" android:endColor="#100D18" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#00000000" android:endColor="#66000000" />
        </shape>
    </item>
</layer-list>
