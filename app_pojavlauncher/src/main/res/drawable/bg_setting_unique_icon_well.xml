<?xml version="1.0" encoding="utf-8"?>
<!-- Aurora row icon well — teal-glow glass tile, 16dp radius. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#162B23" android:endColor="#0D141C" />
            <stroke android:width="1dp" android:color="#3A62D99B" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="24dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#1E62D99B" android:endColor="#0062D99B" />
            <corners android:topLeftRadius="15dp" android:topRightRadius="15dp" />
        </shape>
    </item>
</layer-list>