<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle"><corners android:radius="3dp" /><solid android:color="#2B2F38" /></shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip><shape android:shape="rectangle"><corners android:radius="3dp" /><solid android:color="#3B4049" /></shape></clip>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape android:shape="rectangle"><corners android:radius="3dp" /><solid android:color="#C9CED8" /></shape></clip>
    </item>
</layer-list>
