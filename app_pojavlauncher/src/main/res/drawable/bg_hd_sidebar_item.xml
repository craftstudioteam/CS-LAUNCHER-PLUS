<?xml version="1.0" encoding="utf-8"?>
<!-- Sidebar icon button — idle (subtle), pressed (light), selected (violet glow pill with rim). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="135" android:startColor="#9B6BFF" android:endColor="#6D28D9" />
                    <corners android:radius="15dp" />
                    <stroke android:width="1dp" android:color="#C9B3FF" />
                </shape>
            </item>
            <!-- inner top gloss -->
            <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="18dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#33FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:topLeftRadius="14dp" android:topRightRadius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <corners android:radius="15dp" />
            <stroke android:width="1dp" android:color="#4D8B5CF6" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#26201A33" android:endColor="#14161022" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</selector>
