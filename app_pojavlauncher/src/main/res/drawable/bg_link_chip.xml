<?xml version="1.0" encoding="utf-8"?>
<!-- Tappable outlined chip for external project links -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#17171D" />
            <stroke
                android:width="1dp"
                android:color="#33333C" />
            <corners android:radius="14dp" />
            <padding
                android:left="12dp"
                android:top="8dp"
                android:right="12dp"
                android:bottom="8dp" />
        </shape>
    </item>
</ripple>
