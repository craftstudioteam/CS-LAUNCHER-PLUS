<?xml version="1.0" encoding="utf-8"?>
<!-- Aurora stat tile: small numbered tile under hero cards. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="14dp" />
    <gradient
        android:angle="270"
        android:startColor="#20242E"
        android:endColor="#171B22" />
    <stroke android:width="1dp" android:color="#2B3240" />
</shape>
