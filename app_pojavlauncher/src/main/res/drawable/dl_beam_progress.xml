<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded-cap beam progress: purple gradient fill over a graphite track. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="#241F2E" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <gradient android:startColor="#9C7BD8" android:endColor="#7A5BC0"
                    android:angle="0" />
                <corners android:radius="3dp" />
            </shape>
        </clip>
    </item>
</layer-list>
