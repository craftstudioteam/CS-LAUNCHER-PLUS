<?xml version="1.0" encoding="utf-8"?>
<!-- Aurora settings action button — teal gradient pill, pressed lift. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#3BC97E" />
            <stroke android:width="1dp" android:color="#90FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#62D99B"
                android:endColor="#2FBF7D" />
            <stroke android:width="1dp" android:color="#70FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>