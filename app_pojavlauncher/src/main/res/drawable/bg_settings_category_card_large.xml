<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#28D0D0D0">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#22222B"
                        android:centerColor="#1B1B22"
                        android:endColor="#121216" />
                    <corners android:radius="22dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#66D0D0D0" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#1B1B22"
                        android:centerColor="#141419"
                        android:endColor="#101014" />
                    <corners android:radius="22dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#1EFFFFFF" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
