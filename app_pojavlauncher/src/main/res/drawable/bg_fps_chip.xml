<?xml version="1.0" encoding="utf-8"?>
<!-- FPS HUD chip — premium glass pill: obsidian gradient, platinum edge,
     inner top sheen. Shared by the FPS and Memory chips. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient android:angle="270"
                android:startColor="#E61A1C22"
                android:endColor="#E60F1014" />
            <stroke android:width="1dp" android:color="#66B9BEC9" />
        </shape>
    </item>
    <item android:top="1dp" android:left="8dp" android:right="8dp" android:bottom="18dp">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="#14FFFFFF" />
        </shape>
    </item>
</layer-list>
