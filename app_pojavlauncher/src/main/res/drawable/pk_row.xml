<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#262A33" />
            <stroke android:width="1dp" android:color="#C9CED8" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#23262E" />
            <stroke android:width="1dp" android:color="#3B4049" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#181A20" />
            <stroke android:width="1dp" android:color="#2B2F38" />
        </shape>
    </item>
</selector>
