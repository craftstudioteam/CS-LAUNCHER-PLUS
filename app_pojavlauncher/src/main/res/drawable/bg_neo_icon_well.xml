<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#181E2A" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#2A3545" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#0E141C" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</layer-list>
