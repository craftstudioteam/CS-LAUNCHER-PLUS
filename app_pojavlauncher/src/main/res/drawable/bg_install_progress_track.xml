<?xml version="1.0" encoding="utf-8"?>
<!-- Per-runtime install bar: charcoal track with a soft warm beam fill. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#1B1B22" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient
                    android:angle="0"
                    android:startColor="#E8DCB4"
                    android:centerColor="#D8C79A"
                    android:endColor="#BFAA76"
                    android:type="linear" />
                <corners android:radius="999dp" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="#40D8C79A" />
                <corners android:radius="999dp" />
            </shape>
        </clip>
    </item>
</layer-list>
