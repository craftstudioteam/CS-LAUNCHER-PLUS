<?xml version="1.0" encoding="utf-8"?>
<!-- MP SMALL CARD — compact glass tile for inline sections -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#20FFFFFF">
    <item android:id="@android:id/background">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient android:angle="135" android:startColor="#191B22" android:endColor="#0F1014" />
                    <stroke android:width="1dp" android:color="#24FFFFFF" />
                </shape>
            </item>
            <item android:top="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="15dp" />
                    <gradient android:angle="270" android:startColor="#10FFFFFF" android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
