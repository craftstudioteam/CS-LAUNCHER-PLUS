<?xml version="1.0" encoding="utf-8"?>
<!-- MP MOD CARD — hero media card: lifted body, rim light, violet edge whisper -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#24FFFFFF">
    <item android:id="@android:id/background">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <solid android:color="#090A0E" />
                </shape>
            </item>
            <item android:bottom="1.5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <gradient android:angle="135" android:startColor="#1E2028" android:endColor="#101116" />
                    <stroke android:width="1dp" android:color="#2DFFFFFF" />
                </shape>
            </item>
            <item android:top="1dp" android:bottom="1.5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="19dp" />
                    <gradient android:angle="270" android:startColor="#14FFFFFF" android:centerColor="#05FFFFFF" android:endColor="#00FFFFFF" />
                </shape>
            </item>
            <item android:top="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="19dp" />
                    <gradient android:angle="0" android:startColor="#1FD0D0D0" android:centerColor="#08D0D0D0" android:endColor="#00D0D0D0" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
