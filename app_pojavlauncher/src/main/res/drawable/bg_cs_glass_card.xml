<?xml version="1.0" encoding="utf-8"?>
<!-- GLASS CARD — 20dp radius, translucent fill, hairline stroke,
     faint top-light for depth (glassmorphism without runtime blur). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <gradient
        android:angle="270"
        android:startColor="#14FFFFFF"
        android:endColor="#0AFFFFFF" />
    <stroke android:width="1dp" android:color="#24FFFFFF" />
</shape>
