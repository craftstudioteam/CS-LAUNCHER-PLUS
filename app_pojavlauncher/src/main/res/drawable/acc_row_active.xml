<?xml version="1.0" encoding="utf-8"?>
<!-- Account picker — the signed-in row: silver ring + lighter surface. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#22FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:angle="0" android:startColor="#23262E" android:endColor="#1B1D23" />
            <stroke android:width="1.5dp" android:color="#C9CED8" />
        </shape>
    </item>
</ripple>
