<?xml version="1.0" encoding="utf-8"?>
<!-- Backdrop for a skin preview: dim glass with a light pool behind the figure. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:endColor="#0B0C10"
                android:startColor="#15171E" />
            <stroke
                android:width="1dp"
                android:color="#2EFFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="oval">
            <gradient
                android:endColor="#00000000"
                android:gradientRadius="62%"
                android:startColor="#2222C9CB"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
