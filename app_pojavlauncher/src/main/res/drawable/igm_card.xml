<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#262A33" />
            <stroke android:width="1dp" android:color="#4A4F5A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="270" android:startColor="#1D1F26" android:endColor="#15171C" />
            <stroke android:width="1dp" android:color="#2B2F38" />
        </shape>
    </item>
</selector>
