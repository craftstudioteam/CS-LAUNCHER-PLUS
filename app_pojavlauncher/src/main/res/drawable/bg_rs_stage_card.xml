<?xml version="1.0" encoding="utf-8"?>
<!-- Runtime stage card (idle/queued): layered graphite + platinum rim + violet top hairline -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270"
                android:startColor="#1D1E24" android:centerColor="#17181D" android:endColor="#121316" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#2B2B33" />
        </shape>
    </item>
    <item android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:angle="0"
                android:startColor="#00D0D0D0" android:centerColor="#8CD0D0D0" android:endColor="#00D0D0D0" />
            <size android:height="2dp" />
            <corners android:topLeftRadius="18dp" android:topRightRadius="18dp" />
        </shape>
    </item>
    <item android:top="0.8dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="19dp" />
            <stroke android:width="0.8dp" android:color="#14FFFFFF" />
        </shape>
    </item>
</layer-list>
