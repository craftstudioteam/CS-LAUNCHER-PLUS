<?xml version="1.0" encoding="utf-8"?>
<!-- MP IMAGE WELL — rounded media frame with inner rim -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#14151B" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <gradient android:angle="135" android:startColor="#10FFFFFF" android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
