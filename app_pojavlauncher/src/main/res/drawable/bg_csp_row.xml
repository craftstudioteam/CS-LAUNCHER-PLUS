<?xml version="1.0" encoding="utf-8"?>
<!-- CSP SETTING ROW — layered obsidian glass with inner top highlight -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#14FFFFFF">
    <item android:id="@android:id/background">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="#101013" />
                    <stroke android:width="1dp" android:color="#1AFFFFFF" />
                </shape>
            </item>
            <item android:top="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="17dp" />
                    <gradient android:angle="270" android:startColor="#10FFFFFF" android:centerColor="#05FFFFFF" android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
