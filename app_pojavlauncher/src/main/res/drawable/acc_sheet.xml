<?xml version="1.0" encoding="utf-8"?>
<!-- Account picker — graphite card with a faint inner hairline. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient android:angle="270" android:startColor="#1B1D23" android:endColor="#121318" />
            <stroke android:width="1dp" android:color="#2F323B" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="21dp" />
            <stroke android:width="1dp" android:color="#0DFFFFFF" />
        </shape>
    </item>
</layer-list>
