<?xml version="1.0" encoding="utf-8"?>
<!-- Runtime stage card (ready): installed-green rim iteration -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270"
                android:startColor="#14231B" android:centerColor="#121E17" android:endColor="#101713" />
            <corners android:radius="18dp" />
            <stroke android:width="1.2dp" android:color="#2E7D54" />
        </shape>
    </item>
    <item android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:angle="0"
                android:startColor="#0022C55E" android:centerColor="#A622C55E" android:endColor="#0022C55E" />
            <size android:height="2dp" />
            <corners android:topLeftRadius="18dp" android:topRightRadius="18dp" />
        </shape>
    </item>
    <item android:top="0.8dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="17dp" />
            <stroke android:width="0.8dp" android:color="#1EFFFFFF" />
        </shape>
    </item>
</layer-list>
