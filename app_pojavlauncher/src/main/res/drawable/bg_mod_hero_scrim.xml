<?xml version="1.0" encoding="utf-8"?>
<!-- Mod Detail — scrim inside the rounded card: readable text over any screenshot.
     Radius matches the card so the artwork can never square off a corner. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="#80090A0C"
        android:centerY="0.35"
        android:endColor="#F2090A0C"
        android:startColor="#26090A0C" />
    <corners android:radius="16dp" />
</shape>
