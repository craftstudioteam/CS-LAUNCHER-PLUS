<?xml version="1.0" encoding="utf-8"?>
<!-- Control editor — floating action pill (delete / clone / add sub). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient android:angle="270" android:startColor="#F2262931" android:endColor="#F2141519" />
            <stroke android:width="1dp" android:color="#4A4F5A" />
        </shape>
    </item>
</ripple>
