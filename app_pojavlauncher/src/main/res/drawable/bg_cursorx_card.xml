<?xml version="1.0" encoding="utf-8"?>
<!-- Cursor Studio v4 — section card with top sheen -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient android:angle="270" android:startColor="#16181E" android:endColor="#101116" />
            <stroke android:width="1dp" android:color="#242731" />
        </shape>
    </item>
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="30dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="17dp" android:topRightRadius="17dp" />
            <gradient android:angle="270" android:startColor="#0DFFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
