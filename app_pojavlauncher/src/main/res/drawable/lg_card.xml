<?xml version="1.0" encoding="utf-8"?>
<!-- Log terminal v3 — near-opaque graphite card, silver hairline. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient android:angle="270" android:startColor="#F21A1C22" android:endColor="#F60D0F14" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <stroke android:width="1.5dp" android:color="#363A44" />
        </shape>
    </item>
</layer-list>
