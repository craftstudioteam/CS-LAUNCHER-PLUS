<?xml version="1.0" encoding="utf-8"?>
<!-- Hero card for the install page: subtle lift with silver hairline -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#191920"
        android:centerColor="#15151B"
        android:endColor="#141419"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#2D2D35" />
    <corners android:radius="22dp" />
</shape>
