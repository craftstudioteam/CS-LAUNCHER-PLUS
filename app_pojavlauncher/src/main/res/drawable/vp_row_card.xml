<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#FF16181D" />
            <stroke android:width="1dp" android:color="#23262E" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <gradient android:angle="270" android:startColor="#0DFFFFFF" android:endColor="#00FFFFFF" android:centerY="0.3" android:centerColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
