<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#1E2027" />
            <stroke android:width="1dp" android:color="#4A4F5A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:angle="270" android:startColor="#16181D" android:endColor="#101115" />
            <stroke android:width="1dp" android:color="#262A33" />
        </shape>
    </item>
</selector>