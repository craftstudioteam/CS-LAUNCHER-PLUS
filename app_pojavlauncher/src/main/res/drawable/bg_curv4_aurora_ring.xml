    android:useLevel="false" android:innerRadiusRatio="2.35" android:thicknessRatio="55">
    <gradient android:type="sweep" android:startColor="#E63DC2FF"
        android:centerColor="#E67C5CFF" android:endColor="#E63DC2FF"/>
</shape>
