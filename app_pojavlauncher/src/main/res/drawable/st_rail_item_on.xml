<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#1E2027" />
            <stroke android:width="1dp" android:color="#3B4049" />
        </shape>
    </item>
    <item android:width="3dp" android:gravity="start|center_vertical" android:height="18dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="#E6E9EF" />
        </shape>
    </item>
</layer-list>