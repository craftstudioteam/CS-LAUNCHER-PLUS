<?xml version="1.0" encoding="utf-8"?>
<!-- Button plate for the button-edit sheet: soft graphite fill, a hairline, and
     a top highlight so it reads as raised rather than painted on. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/au_tile_press">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="90"
                android:endColor="#12FFFFFF"
                android:startColor="#08FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#24FFFFFF" />
        </shape>
    </item>
</ripple>
