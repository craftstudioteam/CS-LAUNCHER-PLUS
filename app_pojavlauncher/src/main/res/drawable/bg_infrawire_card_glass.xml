<?xml version="1.0" encoding="utf-8"?>
<!-- Premium glass card: deep space gradient, neon-blue hairline, 24dp corners -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="#1B1B22"
        android:centerColor="#141419"
        android:endColor="#0B0B0E" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="#33D0D0D0" />
</shape>
