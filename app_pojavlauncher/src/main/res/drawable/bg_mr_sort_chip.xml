<?xml version="1.0" encoding="utf-8"?>
<!-- Single sort control: quiet outline pill that opens the ordering sheet. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#20FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1B1D23" />
            <stroke android:width="1dp" android:color="#2E3038" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</ripple>
