<?xml version="1.0" encoding="utf-8"?>
<!-- Aurora settings active chip — teal gradient pill, dark text. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#22080E11">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#62D99B"
                android:centerColor="#54CE90"
                android:endColor="#3FC080" />
            <corners android:radius="999dp" />
            <stroke
                android:width="1dp"
                android:color="#70FFFFFF" />
        </shape>
    </item>
</ripple>