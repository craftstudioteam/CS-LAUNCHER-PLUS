<?xml version="1.0" encoding="utf-8"?>
<!-- CSP BIG CARD — deep glass panel for category/pin cards -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#14FFFFFF">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient android:angle="315" android:startColor="#17171B" android:endColor="#0D0D10" />
            <stroke android:width="1dp" android:color="#1FA2A2AE" />
        </shape>
    </item>
</ripple>
