<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Default (Dark) ───────────────────────────────────── -->
    <style name="AppTheme" parent="@style/Theme.Material3.Dark.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
        <!-- Transparent bars: true fullscreen with NO painted horizontal strip
             at the top/bottom. The immersive Home artwork fills edge to edge. -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
        <item name="android:textSize">@dimen/_14ssp</item>
        <item name="colorBgApp">#0B0B0E</item>
        <item name="colorBgBottomBar">#0B0B0E</item>
        <item name="colorBgStatusBar">#0B0B0E</item>
        <item name="colorDivider">#26262E</item>
        <item name="themeAccent">@color/minebutton_color</item>
        <item name="colorTextPrimary">@color/primary_text</item>
        <item name="colorTextSecondary">@color/secondary_text</item>
        <item name="bgMainDrawable">#0B0B0E</item>
        <item name="android:windowBackground">#0B0B0E</item>
        <!-- Explicit Material 3 palette: blocks its built-in #D0BCFF lavender fallback. -->
        <item name="colorPrimary">#FFFFFF</item>
        <item name="colorOnPrimary">#0D0D0D</item>
        <item name="colorPrimaryContainer">#FFFFFF</item>
        <item name="colorOnPrimaryContainer">#0D0D0D</item>
        <item name="colorSecondary">#D0D0D0</item>
        <item name="colorOnSecondary">#0D0D0D</item>
        <item name="colorSecondaryContainer">#25262D</item>
        <item name="colorOnSecondaryContainer">#FFFFFF</item>
        <item name="colorTertiary">#B8B8B8</item>
        <item name="colorOnTertiary">#0D0D0D</item>
        <item name="colorAccent">#FFFFFF</item>
        <item name="colorOnSurface">@color/primary_text</item>
        <item name="colorOnSurfaceVariant">@color/secondary_text</item>
        <item name="colorSurface">#0B0B0E</item>
        <item name="colorSurfaceVariant">#141419</item>
    </style>
    <style name="AppTheme.Gradient">
        <item name="bgMainDrawable">@drawable/bg_gradient_default</item>
        <item name="android:windowBackground">@drawable/bg_gradient_default</item>
        <item name="colorBgBottomBar">@color/cu_bg_bottom_bar</item>
        <item name="colorBgStatusBar">@color/cu_bg_status_bar</item>
        <item name="colorAccent">#FFFFFF</item>
    </style>

