<?xml version="1.0" encoding="utf-8"?>
<!-- CSL v3 rebuilt animation — mobile-friendly, snappy, 60fps. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:fillAfter="true">
    <translate android:duration="280" android:fromXDelta="20" android:toXDelta="0"
        android:interpolator="@android:interpolator/fast_out_slow_in" />
    <translate android:duration="280" android:fromYDelta="8" android:toYDelta="0"
        android:interpolator="@android:interpolator/fast_out_slow_in" />
</set>