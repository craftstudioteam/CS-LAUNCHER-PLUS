<?xml version="1.0" encoding="utf-8"?>
<!-- Shared-axis Z forward (cinematic): the detail screen springs up from 0.80 depth
     with a soft overshoot and a small upward lift — hierarchy you can feel. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <scale
        android:fromXScale="0.80"
        android:toXScale="1.0"
        android:fromYScale="0.80"
        android:toYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="520"
        android:interpolator="@interpolator/motion_spring" />
    <translate
        android:fromYDelta="6%p"
        android:toYDelta="0"
        android:duration="520"
        android:interpolator="@interpolator/motion_out_expo" />
    <alpha
        android:fromAlpha="0"
        android:toAlpha="1"
        android:duration="240"
        android:interpolator="@interpolator/motion_standard" />
</set>
