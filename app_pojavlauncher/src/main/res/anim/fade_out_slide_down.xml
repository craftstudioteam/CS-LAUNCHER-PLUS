<?xml version="1.0" encoding="utf-8"?>
<!-- CSL v3 rebuilt animation — mobile-friendly, snappy, 60fps. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:fillAfter="true">
    <alpha android:duration="240" android:fromAlpha="1.0" android:toAlpha="0.0"
        android:interpolator="@android:interpolator/accelerate_quad" />
    <translate android:duration="240" android:fromYDelta="0" android:toYDelta="12"
        android:interpolator="@android:interpolator/accelerate_quad" />
</set>