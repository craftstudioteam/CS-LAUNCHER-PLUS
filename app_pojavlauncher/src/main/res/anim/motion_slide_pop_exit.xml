<?xml version="1.0" encoding="utf-8"?>
<!-- Shared-axis X back (cinematic): the closing page accelerates off to the right
     and shrinks slightly — quick, decisive dismissal. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <translate
        android:fromXDelta="0"
        android:toXDelta="32%p"
        android:duration="380"
        android:interpolator="@interpolator/motion_emphasized" />
    <scale
        android:fromXScale="1.0"
        android:toXScale="0.94"
        android:fromYScale="1.0"
        android:toYScale="0.94"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="380"
        android:interpolator="@interpolator/motion_emphasized" />
    <alpha
        android:fromAlpha="1"
        android:toAlpha="0"
        android:duration="240"
        android:interpolator="@interpolator/motion_in_quart" />
</set>
