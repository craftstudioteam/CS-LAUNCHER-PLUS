<?xml version="1.0" encoding="utf-8"?>
<!-- Premium dialog entrance: rise + settle with a soft overshoot -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/decelerate_interpolator">
    <alpha android:duration="220" android:fromAlpha="0" android:toAlpha="1" />
    <scale android:duration="260"
        android:fromXScale="0.9" android:toXScale="1"
        android:fromYScale="0.9" android:toYScale="1"
        android:pivotX="50%" android:pivotY="55%"
        android:interpolator="@android:anim/overshoot_interpolator" />
    <translate android:duration="260" android:fromYDelta="4%" android:toYDelta="0" />
</set>
