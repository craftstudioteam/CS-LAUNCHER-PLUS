<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     ABOUT — "BUILD MANIFEST" (Phase 9 redesign)
     Top status bar (back · title · version key-cap), then a two-column
     dossier: LEFT fixed identity card (logo, name, tagline, channel
     links), RIGHT scrolling manifest with numbered sections —
     01 TEAM (2×2 tiles) · 02 LINEAGE (Pojav / Amethyst) · 03 LEGAL.
     Ids used by AboutFragment preserved (about_*).
     ═══════════════════════════════════════════════════════════════════ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/au9_page"
    android:orientation="vertical">

    <!-- status bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/au9_statusbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/about_back_button"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/au9_btn_ghost"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:paddingHorizontal="12dp"
            android:text="←  BACK"
            android:textColor="#E6E9EF"
            android:textSize="10.5sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.14"
            android:text="BUILD MANIFEST  ·  ABOUT"
            android:textColor="#8A909C"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/about_version_chip"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/au9_keycap"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="v1.0.0"
            android:textColor="#C9CED8"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- ── LEFT: identity card ── -->
        <LinearLayout
            android:id="@+id/about_hero_card"
            android:layout_width="236dp"
            android:layout_height="match_parent"
            android:background="@drawable/ab_hero"
            android:orientation="vertical"
            android:padding="18dp">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/au9_icon_well">

                <ImageView
                    android:id="@+id/about_cs_logo"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/cs_logo" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/cs_about_name"
                android:textColor="#F4F6F9"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:text="@string/cs_about_tagline"
                android:textColor="#8A909C"
                android:textSize="9sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="#2B2F38" />

            <TextView
                android:id="@+id/about_links_heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.16"
                android:text="CHANNELS"
                android:textColor="#6B7180"
                android:textSize="9sp" />

            <LinearLayout
                android:id="@+id/about_link_discord"
                style="@style/AbLink">

                <ImageView style="@style/AbLinkIcon" android:src="@drawable/ic_discord" />
                <LinearLayout style="@style/AbLinkTextCol">
                    <TextView style="@style/AbLinkTitle" android:text="@string/cs_about_discord_title" />
                    <TextView style="@style/AbLinkSub" android:text="@string/cs_about_discord_sub" />
                </LinearLayout>
                <TextView style="@style/AbLinkArrow" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/about_link_website"
                style="@style/AbLink">

                <ImageView style="@style/AbLinkIcon" android:src="@drawable/ic_website_orbit" />
                <LinearLayout style="@style/AbLinkTextCol">
                    <TextView style="@style/AbLinkTitle" android:text="@string/cs_about_website_title" />
                    <TextView style="@style/AbLinkSub" android:text="@string/cs_about_website_sub" />
                </LinearLayout>
                <TextView style="@style/AbLinkArrow" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/about_link_github"
                style="@style/AbLink">

                <ImageView style="@style/AbLinkIcon" android:src="@drawable/ic_github" />
                <LinearLayout style="@style/AbLinkTextCol">
                    <TextView style="@style/AbLinkTitle" android:text="@string/cs_about_github_title" />
                    <TextView style="@style/AbLinkSub" android:text="@string/cs_about_github_sub" />
                </LinearLayout>
                <TextView style="@style/AbLinkArrow" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/cs_about_footer"
                android:textColor="#4F5460"
                android:textSize="8.5sp" />
        </LinearLayout>

        <!-- ── RIGHT: manifest ── -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp">

                <!-- 01 TEAM -->
                <LinearLayout style="@style/AbSectionHead">
                    <TextView style="@style/AbIndex" android:text="01" />
                    <TextView android:id="@+id/about_credits_heading" style="@style/AbSectionTitle" android:text="Team" />
                    <View style="@style/AbRule" />
                    <TextView style="@style/AbSectionMeta" android:text="CRAFT STUDIO" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/AbTeamTile" android:layout_marginEnd="5dp">
                        <FrameLayout style="@style/AbAvatarRing">
                            <net.kdt.pojavlaunch.ui.AvatarView style="@style/AbAvatar" android:src="@drawable/cs_team_rohit" />
                        </FrameLayout>
                        <LinearLayout style="@style/AbTeamTextCol">
                            <TextView style="@style/AbTeamName" android:text="ROHIT_45" />
                            <TextView style="@style/AbTeamRole" android:text="LEAD DEVELOPER" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout style="@style/AbTeamTile" android:layout_marginStart="5dp">
                        <FrameLayout style="@style/AbAvatarRing">
                            <net.kdt.pojavlaunch.ui.AvatarView style="@style/AbAvatar" android:src="@drawable/cs_team_notdanger" />
                        </FrameLayout>
                        <LinearLayout style="@style/AbTeamTextCol">
                            <TextView style="@style/AbTeamName" android:text="NOT DANGER" />
                            <TextView style="@style/AbTeamRole" android:text="FOUNDER" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/AbTeamTile" android:layout_marginEnd="5dp">
                        <FrameLayout style="@style/AbAvatarRing">
                            <net.kdt.pojavlaunch.ui.AvatarView style="@style/AbAvatar" android:src="@drawable/cs_team_mineradi" />
                        </FrameLayout>
                        <LinearLayout style="@style/AbTeamTextCol">
                            <TextView style="@style/AbTeamName" android:text="MINER_ADI" />
                            <TextView style="@style/AbTeamRole" android:text="FOUNDER" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout style="@style/AbTeamTile" android:layout_marginStart="5dp">
                        <FrameLayout style="@style/AbAvatarRing">
                            <net.kdt.pojavlaunch.ui.AvatarView style="@style/AbAvatar" android:src="@drawable/cs_team_ender" />
                        </FrameLayout>
                        <LinearLayout style="@style/AbTeamTextCol">
                            <TextView style="@style/AbTeamName" android:text="ENDER" />
                            <TextView style="@style/AbTeamRole" android:text="FOUNDER" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- 02 LINEAGE -->
                <LinearLayout style="@style/AbSectionHead">
                    <TextView style="@style/AbIndex" android:text="02" />
                    <TextView style="@style/AbSectionTitle" android:text="Lineage" />
                    <View style="@style/AbRule" />
                    <TextView style="@style/AbSectionMeta" android:text="@string/cs_about_credit_badge" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/about_pojav_card"
                    style="@style/AbLineageCard">

                    <FrameLayout style="@style/AbLineageIconWell">
                        <ImageView style="@style/AbLineageIcon" android:src="@drawable/pojav_logo" />
                    </FrameLayout>
                    <LinearLayout style="@style/AbLineageTextCol">
                        <TextView style="@style/AbLineageName" android:text="@string/cs_about_pojav_name" />
                        <TextView style="@style/AbLineageRole" android:text="@string/cs_about_pojav_role" />
                        <TextView style="@style/AbLineageDesc" android:text="@string/cs_about_pojav_desc" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/about_amethyst_card"
                    style="@style/AbLineageCard"
                    android:layout_marginTop="10dp">

                    <FrameLayout style="@style/AbLineageIconWell">
                        <ImageView style="@style/AbLineageIcon" android:src="@drawable/amethyst_logo" />
                    </FrameLayout>
                    <LinearLayout style="@style/AbLineageTextCol">
                        <TextView style="@style/AbLineageName" android:text="@string/cs_about_amethyst_name" />
                        <TextView style="@style/AbLineageRole" android:text="@string/cs_about_amethyst_role" />
                        <TextView style="@style/AbLineageDesc" android:text="@string/cs_about_amethyst_desc" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 03 LEGAL -->
                <LinearLayout style="@style/AbSectionHead">
                    <TextView style="@style/AbIndex" android:text="03" />
                    <TextView android:id="@+id/about_legal_heading" style="@style/AbSectionTitle" android:text="@string/cs_about_legal_heading" />
                    <View style="@style/AbRule" />
                    <TextView style="@style/AbSectionMeta" android:text="GPL-3.0" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/about_legal_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ab_legal"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/about_legal_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:lineSpacingMultiplier="1.3"
                        android:textColor="#8A909C"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
