<?xml version="1.0" encoding="utf-8"?>
<!-- One managed shortcut: icon, label, action + profile, usage count, delete. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_glass_card_premium"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <ImageView
        android:id="@+id/entry_icon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginEnd="14dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/entry_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/primary_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/entry_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/secondary_text"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/entry_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/premium_cyan"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Shown when the owning profile no longer exists. -->
    <TextView
        android:id="@+id/entry_orphan_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_chip_dark"
        android:paddingHorizontal="7dp"
        android:paddingVertical="2dp"
        android:text="@string/shortcut_orphaned"
        android:textColor="#FF6B6B"
        android:textSize="9sp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/entry_delete"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/shortcut_remove"
        android:src="@drawable/ic_menu_delete_forever"
        android:tint="#FF6B6B" />

</LinearLayout>
