<?xml version="1.0" encoding="utf-8"?>
<!-- ════════════════════════════════════════════════════════════════
     CS LAUNCHER PLUS — first-launch thank-you popup (Phase 10 rebuild).
     Shown exactly once, between the runtime installer and the Home
     tutorial. The old 400dp card crammed a 700-character paragraph
     into 13sp — unreadable. Now: a wide two-pane sheet that fills the
     landscape screen (window sized in PlusWelcomeDialog.onStart):
       • left pane  — brand mark, thank-you hero, three highlight chips
       • right pane — five readable feature rows (glyph / title / line)
     Same ids as before (plus_welcome_dim/card/btn_cancel/hero/body/
     btn_continue/note) so the fragment code is unchanged.
     ════════════════════════════════════════════════════════════════ -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/plus_welcome_dim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/plus_welcome_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginStart="14dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_glass_dialog"
        android:baselineAligned="false"
        android:elevation="18dp"
        android:orientation="horizontal">

        <!-- ═══ LEFT PANE — brand + hero + chips ═══ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.42"
            android:background="@drawable/pw_left_pane"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="20dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_deck_icon_tile"
                    android:elevation="4dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/plus_welcome_title"
                        android:src="@mipmap/ic_launcher" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.03"
                        android:maxLines="1"
                        android:text="@string/plus_welcome_title"
                        android:textColor="#F4F6F9"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="11dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_flag_india" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.12"
                            android:text="@string/plus_welcome_subtitle"
                            android:textColor="#9AA0AC"
                            android:textSize="9.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- thank-you hero: big and readable -->
            <TextView
                android:id="@+id/plus_welcome_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="4dp"
                android:text="@string/plus_welcome_hero"
                android:textColor="#F4F6F9"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/plus_welcome_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/plus_welcome_intro"
                android:textColor="#C9CED8"
                android:textSize="14sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- highlight chips (stacked so they stay legible) -->
            <TextView
                style="@style/PwChip"
                android:text="@string/plus_welcome_chip_versions" />

            <TextView
                style="@style/PwChip"
                android:layout_marginTop="6dp"
                android:text="@string/plus_welcome_chip_mods" />

            <TextView
                style="@style/PwChip"
                android:layout_marginTop="6dp"
                android:text="@string/plus_welcome_chip_control" />
        </LinearLayout>

        <!-- ═══ RIGHT PANE — feature rows + CTA ═══ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.58"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp">

            <!-- header row: kicker + X -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.16"
                    android:text="@string/plus_welcome_kicker"
                    android:textColor="#6B7180"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/plus_welcome_btn_cancel"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_plus_welcome_cancel"
                    android:clickable="true"
                    android:contentDescription="@string/plus_welcome_cancel"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/plus_welcome_cancel_symbol"
                    android:textColor="#C7CBD4"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:fadeScrollbars="true"
                android:scrollbars="vertical">

                <LinearLayout
                    android:id="@+id/plus_welcome_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout style="@style/PwRow">
                        <TextView style="@style/PwGlyph" android:text="@string/plus_welcome_g_accounts" />
                        <LinearLayout style="@style/PwRowText">
                            <TextView style="@style/PwRowTitle" android:text="@string/plus_welcome_t_accounts" />
                            <TextView style="@style/PwRowLine" android:text="@string/plus_welcome_d_accounts" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout style="@style/PwRow">
                        <TextView style="@style/PwGlyph" android:text="@string/plus_welcome_g_profiles" />
                        <LinearLayout style="@style/PwRowText">
                            <TextView style="@style/PwRowTitle" android:text="@string/plus_welcome_t_profiles" />
                            <TextView style="@style/PwRowLine" android:text="@string/plus_welcome_d_profiles" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout style="@style/PwRow">
                        <TextView style="@style/PwGlyph" android:text="@string/plus_welcome_g_perf" />
                        <LinearLayout style="@style/PwRowText">
                            <TextView style="@style/PwRowTitle" android:text="@string/plus_welcome_t_perf" />
                            <TextView style="@style/PwRowLine" android:text="@string/plus_welcome_d_perf" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout style="@style/PwRow">
                        <TextView style="@style/PwGlyph" android:text="@string/plus_welcome_g_controls" />
                        <LinearLayout style="@style/PwRowText">
                            <TextView style="@style/PwRowTitle" android:text="@string/plus_welcome_t_controls" />
                            <TextView style="@style/PwRowLine" android:text="@string/plus_welcome_d_controls" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout style="@style/PwRow" android:layout_marginBottom="0dp">
                        <TextView style="@style/PwGlyph" android:text="@string/plus_welcome_g_updates" />
                        <LinearLayout style="@style/PwRowText">
                            <TextView style="@style/PwRowTitle" android:text="@string/plus_welcome_t_updates" />
                            <TextView style="@style/PwRowLine" android:text="@string/plus_welcome_d_updates" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- CTA -->
            <TextView
                android:id="@+id/plus_welcome_btn_continue"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_infrawire_button_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:text="@string/plus_welcome_continue"
                android:textColor="#0E0E11"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/plus_welcome_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/plus_welcome_note"
                android:textColor="#6E7580"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
