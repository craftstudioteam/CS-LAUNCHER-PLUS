<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B0000000"
    android:gravity="center"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/update_card"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_s4_card"
        android:orientation="vertical"
        android:padding="22dp"
        android:elevation="14dp"
        android:layout_margin="24dp">

        <!-- Title Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tv_update_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="UPDATE"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

        </LinearLayout>

        <!-- Version Subtitle -->
        <TextView
            android:id="@+id/tv_update_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="New version available"
            android:textColor="#D0D0D0"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#242424"
            android:layout_marginBottom="12dp" />

        <!-- Changelog / New features area -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="16dp"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tv_update_changelog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#EDEDF2"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:text="New features / changes" />

        </ScrollView>

        <!-- Progress Area (shown during download) -->
        <LinearLayout
            android:id="@+id/update_progress_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tv_update_progress_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Downloading update... 0%"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <ProgressBar
                android:id="@+id/update_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/bg_s4_accent_bar" />

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:id="@+id/update_buttons_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <TextView
                android:id="@+id/btn_update_later"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Later"
                android:textColor="#D0D0D0"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_settings_row"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_update_now"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="UPDATE"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_settings_btn"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
