<?xml version="1.0" encoding="utf-8"?>
<!-- Lists every shortcut this launcher created, with usage stats and removal. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0B10"
    android:orientation="vertical">

    <!-- ── Header ─────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#10131B"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageButton
            android:id="@+id/shortcut_manager_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/st_btn_ghost"
            android:contentDescription="@string/global_back"
            android:src="@drawable/ic_arrow_back_white"
            app:tint="#C5C8D4" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/shortcut_manage_title"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shortcut_manager_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#7C8494"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/shortcut_manager_clear_all"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/st_btn_ghost"
            android:contentDescription="@string/shortcut_remove_all"
            android:src="@drawable/ic_menu_delete_forever"
            app:tint="#FF6B6B" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A1E2C" />

    <!-- ── List ───────────────────────────────────────────────────── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/shortcut_manager_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="24dp" />

    <!-- ── Empty state ────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/shortcut_manager_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:alpha="0.4"
            android:contentDescription="@null"
            android:src="@drawable/ic_shortcut_add"
            app:tint="#4E5568" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/shortcut_manage_empty"
            android:textColor="#C5C8D4"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/shortcut_manage_empty_hint"
            android:textColor="#7C8494"
            android:textSize="11.5sp" />
    </LinearLayout>

</LinearLayout>
