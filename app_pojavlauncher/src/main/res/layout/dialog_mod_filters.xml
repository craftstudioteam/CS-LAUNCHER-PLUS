<?xml version="1.0" encoding="utf-8"?>
<!-- ════════════════════════════════════════════════════════════════
     FILTERS DIALOG (premium redo)
═════════════════════════════════════════════════════════════════ -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_premium"
    android:paddingHorizontal="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="18dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.14"
        android:text="@string/browse_filter_eyebrow"
        android:textColor="#9C9CA8"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/browse_filter_title"
        android:textColor="#F0F0F3"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Version filter -->
    <TextView
        android:id="@+id/search_mod_mc_version_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:letterSpacing="0.08"
        android:text="@string/profiles_profile_version"
        android:textColor="#7C7C88"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/search_mod_selected_mc_version_textview"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_input_premium"
            android:gravity="center_vertical"
            android:hint="@string/version_select_hint"
            android:paddingHorizontal="14dp"
            android:textColor="#F0F0F3"
            android:textColorHint="#7C7C88"
            android:textSize="13sp" />

        <Button
            android:id="@+id/search_mod_mc_version_button"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_browse_filter_btn"
            android:minWidth="0dp"
            android:paddingHorizontal="16dp"
            android:text="@string/global_select"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- Loader filter -->
    <TextView
        android:id="@+id/search_mod_loader_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:letterSpacing="0.08"
        android:text="@string/browse_filter_loader_label"
        android:textColor="#7C7C88"
        android:textSize="11sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/search_mod_loader_spinner"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_premium"
        android:paddingHorizontal="12dp" />

    <!-- Actions: clear + apply -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/search_mod_clear_filters"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/bg_browse_filter_btn"
            android:paddingHorizontal="18dp"
            android:text="@string/browse_filter_clear"
            android:textAllCaps="false"
            android:textColor="#9C9CA8"
            android:textSize="13sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <Button
            android:id="@+id/search_mod_apply_filters"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="@drawable/bg_install_cta_white"
            android:text="@string/generic_apply"
            android:textAllCaps="true"
            android:textColor="#0E0E11"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
