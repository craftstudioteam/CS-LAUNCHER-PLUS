<?xml version="1.0" encoding="utf-8"?>
<!--
  Account picker popup (mcAccountSpinner.performClick).
  Java ids: acc_sheet, acc_title, acc_count, acc_close, acc_list, acc_scroll, acc_footer.
  Rows are item_account_pick.xml added to acc_list in code (stagger entrance).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/acc_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/acc_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="3dp"
            android:layout_height="26dp"
            android:background="@drawable/csc_accent_bar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.16"
                android:text="ACCOUNTS"
                android:textColor="#8A909C"
                android:textSize="8sp"
                tools:ignore="HardcodedText,SmallSp" />

            <TextView
                android:id="@+id/acc_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="Who is playing?"
                android:textColor="#F4F6F9"
                android:textSize="15sp"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <TextView
            android:id="@+id/acc_count"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/rd_pill"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.06"
            android:paddingHorizontal="9dp"
            android:text="0"
            android:textColor="#C9CED8"
            android:textSize="8.5sp"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/acc_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/csc_chev_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="✕"
            android:textColor="#C9CED8"
            android:textSize="12sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp"
        android:background="#262932" />

    <ScrollView
        android:id="@+id/acc_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/acc_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/acc_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="Tap an account to sign in  ·  bin icon removes it"
        android:textColor="#5C6068"
        android:textSize="8.5sp"
        tools:ignore="HardcodedText" />
</LinearLayout>
