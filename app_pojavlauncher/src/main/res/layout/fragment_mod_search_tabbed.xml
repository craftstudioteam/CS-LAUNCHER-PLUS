<?xml version="1.0" encoding="utf-8"?>
<!-- Browse Resources — compact per-profile discovery page.
     Existing IDs and graphite visual language are preserved. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mp_page">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/mod_store_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_mp_header"
        app:elevation="2dp">

        <LinearLayout
            android:id="@+id/mod_store_header_collapsible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="9dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            app:layout_scrollFlags="scroll|enterAlways|snap">

            <!-- Navigation and page identity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/mod_store_back"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_mp_filter"
                    android:contentDescription="@string/global_back"
                    android:padding="9dp"
                    android:src="@drawable/ic_arrow_back_white"
                    app:tint="#E4E4EA" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/mod_store_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/browse_title"
                        android:textColor="#F4F4F7"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Mods, resource packs and shaders for this profile"
                        android:textColor="#858792"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp">

                    <ImageButton
                        android:id="@+id/search_mod_filter"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_mp_filter"
                        android:contentDescription="@string/browse_filter_cd"
                        android:padding="9dp"
                        android:src="@drawable/ic_filter"
                        app:tint="#E4E4EA" />

                    <View
                        android:id="@+id/search_mod_filter_dot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_mp_filter_dot"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <!-- Search: one clear visual unit, aligned with the content cards -->
            <LinearLayout
                android:id="@+id/search_capsule_container"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_browse_search_field"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="13dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    app:tint="#7F818C" />

                <EditText
                    android:id="@+id/search_mod_edittext"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:hint="@string/browse_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingStart="10dp"
                    android:paddingEnd="4dp"
                    android:singleLine="true"
                    android:textColor="#F0F0F3"
                    android:textColorHint="#777984"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/search_button_go"
                    android:layout_width="64dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_browse_search_action"
                    android:contentDescription="Search"
                    android:gravity="center"
                    android:letterSpacing="0.06"
                    android:text="SEARCH"
                    android:textColor="#E4E4EA"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Stable category switcher -->
        <HorizontalScrollView
            android:id="@+id/tab_scroll"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:fillViewport="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tab_bar"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/bg_mp_tabs_track"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="3dp" />
        </HorizontalScrollView>

        <include
            layout="@layout/infrawire_powered_badge"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="6dp" />
    </com.google.android.material.appbar.AppBarLayout>

    <View
        android:id="@+id/tab_indicator"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/download_view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
