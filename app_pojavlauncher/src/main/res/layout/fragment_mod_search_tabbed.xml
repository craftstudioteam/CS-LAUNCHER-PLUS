<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════════
     BROWSE RESOURCES — one strip of chrome, then the grid.

     The old header stacked four full-width rows (title bar, search, tabs,
     sort chips) plus a "powered by" badge, which is why it read as
     complicated. Everything above the grid now fits in two rows:

       row 1  back · title · filter        + search field
       row 2  Mods / Resource Packs / Shaders ......... Sort: Relevance

     No collapsing header, no AppBarLayout scroll behaviour: in a landscape
     launcher a scrolling header that hides itself is the number one cause of
     "I lost the tabs". The tab strip is always exactly where the user left it.

     Ids still read by ModsSearchFragment: mod_store_header (now a plain
     LinearLayout — findViewById only), mod_store_back, mod_store_title,
     search_mod_filter, search_mod_filter_dot, search_capsule_container,
     search_mod_edittext, search_clear_button, search_button_go (kept as a
     zero-size view: keyboard action / SEARCH share one code path), tab_scroll,
     tab_bar, sort_chip_scroll, sort_chip_bar, tab_indicator,
     download_view_pager.
     ═══════════════════════════════════════════════════════════════════════ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mr_page"
    android:orientation="vertical">

    <!-- ══════════════════ HEADER (fixed, never scrolls away) ══════════════════ -->
    <LinearLayout
        android:id="@+id/mod_store_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_mr_header"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="0dp">

        <!-- identity + search share one row so the header is 58dp tall -->
        <LinearLayout
            android:id="@+id/mod_store_header_collapsible"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/mod_store_back"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_mr_icon_action"
                android:contentDescription="@string/global_back"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="#C9CCD5" />

            <TextView
                android:id="@+id/mod_store_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:includeFontPadding="false"
                android:letterSpacing="-0.01"
                android:text="@string/browse_title"
                android:textColor="#F3F4F7"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- explanatory subtitle: the tabs already say what this page holds -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Mods, resource packs and shaders for this profile"
                android:textColor="#6B6F7C"
                android:textSize="10sp"
                android:visibility="gone" />

            <!-- one search field for the whole page -->
            <LinearLayout
                android:id="@+id/search_capsule_container"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_mr_search_field"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    app:tint="#6E7280" />

                <EditText
                    android:id="@+id/search_mod_edittext"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:hint="@string/browse_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingStart="9dp"
                    android:paddingEnd="4dp"
                    android:singleLine="true"
                    android:textColor="#F2F3F7"
                    android:textColorHint="#666A78"
                    android:textSize="12.5sp" />

                <ImageButton
                    android:id="@+id/search_clear_button"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_mr_clear_btn"
                    android:contentDescription="@string/global_clear"
                    android:padding="4.5dp"
                    android:src="@drawable/ic_mr_close"
                    android:visibility="gone"
                    app:tint="#9DA0AA" />

                <!-- No platinum SEARCH pill: typing already searches, and the
                     keyboard action needs one code path, not a second button.
                     The id is kept on a zero-size view so the existing listener
                     wiring stays valid. -->
                <View
                    android:id="@+id/search_button_go"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp">

                <ImageButton
                    android:id="@+id/search_mod_filter"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_mr_icon_action"
                    android:contentDescription="@string/browse_filter_cd"
                    android:padding="8dp"
                    android:src="@drawable/ic_filter"
                    app:tint="#C9CCD5" />

                <View
                    android:id="@+id/search_mod_filter_dot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_browse_filter_dot"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- ── category tabs and the single sort control, one row ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <HorizontalScrollView
                android:id="@+id/tab_scroll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fillViewport="false"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/tab_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <View
                android:id="@+id/tab_indicator"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <HorizontalScrollView
                android:id="@+id/sort_chip_scroll"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/sort_chip_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>

    <!-- Hairline, not a second panel: the grid is the page, everything else is chrome. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#22242B" />

    <!-- ══════════════════ GRID + page-level progress ══════════════════ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/download_view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 2dp line at the very top edge = "more results are coming". The
             skeleton grid covers the first page, so nothing else spins. -->
        <ProgressBar
            android:id="@+id/browse_progress_line"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="top"
            android:indeterminate="true"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
