<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 10 simple settings row (slider): title + big value, thick track below. ids preserved. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ss_row"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/setting_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_menu_settings"
            app:tint="#9AA0AC" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/setting_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F4F6F9"
                android:textSize="15.5sp" />

            <TextView
                android:id="@+id/setting_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#8A909C"
                android:textSize="12.5sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/setting_fav_star"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:background="@null"
            android:contentDescription="@string/cs_settings_fav_add"
            android:src="@drawable/ic_csp_star_outline"
            android:visibility="gone" />

        <TextView
            android:id="@+id/setting_value_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ss_value_pill"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minWidth="64dp"
            android:minHeight="32dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#F4F6F9"
            android:textSize="15sp" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/setting_seekbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="4dp"
        android:maxHeight="6dp"
        android:minHeight="6dp"
        android:paddingStart="4dp"
        android:paddingTop="12dp"
        android:paddingEnd="4dp"
        android:paddingBottom="12dp"
        android:progressDrawable="@drawable/ss_seek_progress"
        android:splitTrack="false"
        android:thumb="@drawable/ss_seek_thumb"
        android:thumbOffset="4dp" />
</LinearLayout>
