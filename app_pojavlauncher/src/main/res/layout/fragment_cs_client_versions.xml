<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     CS CLIENT • GRAPHITE v2 — VERSION SELECTOR (brand-new layout pattern)
     A compact brand strip + a horizontal 1-2-3 step rail, then a plain
     full-width version LIST (no big centered hero card).
     IDs + View types preserved:
       csc_versions_back (View), csc_versions_header (View = step rail),
       csc_versions_container (LinearLayout), csc_versions_loading (View)
     ═══════════════════════════════════════════════════════════════════ -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/csc_page"
    android:animateLayoutChanges="true">

    <View
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@drawable/csc_bloom"
        android:alpha="0.6" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ── Slim command bar ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/csc_topbar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/csc_versions_back"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/csc_btn_back"
                android:clickable="true"
                android:contentDescription="Back"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="‹"
                android:textColor="#D2D6DE"
                android:textSize="26sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="New CS Client"
                    android:textColor="#F4F6F9"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:layout_marginTop="1dp"
                    android:text="STEP 1 OF 3  •  PICK VERSION"
                    android:textColor="#9AA0AC"
                    android:textSize="9sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/csc_icon_well">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="CS Client"
                    android:src="@drawable/cs_logo"
                    app:tint="#D2D6DE" />
            </FrameLayout>
        </LinearLayout>

        <!-- ── Step rail (header) ── -->
        <LinearLayout
            android:id="@+id/csc_versions_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="22dp"
            android:paddingTop="16dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/csc_step_active"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="1"
                android:textColor="#E6E9EF"
                android:textSize="13sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/csc_step_line" />

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/csc_step_idle"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="2"
                android:textColor="#8A8F99"
                android:textSize="13sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/csc_step_line" />

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/csc_step_idle"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="3"
                android:textColor="#8A8F99"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ── Section label ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp"
            android:paddingTop="10dp">

            <View
                android:layout_width="4dp"
                android:layout_height="16dp"
                android:background="@drawable/csc_accent_bar" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"
                android:text="AVAILABLE MINECRAFT VERSIONS"
                android:textColor="#F4F6F9"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:background="@drawable/csc_badge"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:paddingHorizontal="12dp"
                android:text="FABRIC"
                android:textColor="#9AA0AC"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- ── Version list ── -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="24dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/csc_versions_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <ProgressBar
                android:id="@+id/csc_versions_loading"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="#C9CED8" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
