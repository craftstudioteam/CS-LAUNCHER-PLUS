<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     GRAPHITE v2 — CREATE VERSION / CUSTOM PROFILE ARCHITECT (redesign)
     Root FrameLayout (Java only uses findViewById — root type unimportant).
     IDs + View types preserved:
       vcreate_back(View), vcreate_icon_frame(View), vcreate_icon(ImageView),
       vcreate_name(EditText), vcreate_loader_chips(LinearLayout),
       vcreate_loader_version_row(View), vcreate_loader_version_label(TV),
       vcreate_loader_version_field(LinearLayout/clickable),
       vcreate_loader_version_value(TV), vcreate_mc_version_field(LinearLayout),
       vcreate_mc_version_value(TV), vcreate_hint(TV), vcreate_create(TextView)
     ═══════════════════════════════════════════════════════════════════ -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/csc_page"
    android:animateLayoutChanges="true">

    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/csc_bloom"
        android:alpha="0.6" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ── Command bar ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/csc_topbar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <FrameLayout
                android:id="@+id/vcreate_back"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/csc_btn_back"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Back"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="#D2D6DE" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Create Version"
                    android:textColor="#F4F6F9"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:text="CUSTOM PROFILE ARCHITECT"
                    android:textColor="#9AA0AC"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/csc_badge_accent"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:paddingHorizontal="14dp"
                android:text="CUSTOM"
                android:textColor="#C9CED8"
                android:textSize="10sp" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingBottom="110dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp">

                <!-- ── Identity card ── -->
                <LinearLayout
                    android:id="@+id/vcreate_identity_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/csc_card_hero"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.1"
                        android:text="PROFILE IDENTITY"
                        android:textColor="#C9CED8"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/vcreate_icon_frame"
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:background="@drawable/bg_creation_icon_well"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView
                                android:id="@+id/vcreate_icon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Profile icon"
                                android:padding="10dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/cs_logo" />
                        </FrameLayout>

                        <EditText
                            android:id="@+id/vcreate_name"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:background="@drawable/csc_input"
                            android:fontFamily="sans-serif"
                            android:hint="My Survival Profile"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:inputType="textCapWords"
                            android:maxLines="1"
                            android:paddingHorizontal="16dp"
                            android:textColor="#F1F5F9"
                            android:textColorHint="#7A808C"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif"
                        android:text="Tap the tile to choose a profile icon"
                        android:textColor="#7A808C"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- ── Loader engine card ── -->
                <LinearLayout
                    android:id="@+id/vcreate_engine_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/csc_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="16dp"
                            android:background="@drawable/csc_accent_bar" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.05"
                            android:text="MOD LOADER ENGINE"
                            android:textColor="#F4F6F9"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/vcreate_loader_chips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <!-- Conditional: loader version -->
                    <LinearLayout
                        android:id="@+id/vcreate_loader_version_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/vcreate_loader_version_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.08"
                            android:text="FABRIC LOADER"
                            android:textColor="#C9CED8"
                            android:textSize="9sp" />

                        <LinearLayout
                            android:id="@+id/vcreate_loader_version_field"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_creation_field"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <TextView
                                android:id="@+id/vcreate_loader_version_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif"
                                android:text="Select loader version"
                                android:textColor="#8A909C"
                                android:textSize="13sp" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="Select"
                                android:src="@drawable/ic_chevron_down"
                                app:tint="#C9CED8" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Minecraft version -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="16dp"
                            android:background="@drawable/csc_accent_bar" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.05"
                            android:text="MINECRAFT VERSION"
                            android:textColor="#F4F6F9"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/vcreate_mc_version_field"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_creation_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="MC"
                            android:src="@drawable/img_crafting_table" />

                        <TextView
                            android:id="@+id/vcreate_mc_version_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif"
                            android:text="Select version"
                            android:textColor="#8A909C"
                            android:textSize="13sp" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Select"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="#C9CED8" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/vcreate_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif"
                        android:lineSpacingMultiplier="1.2"
                        android:text="Pick a loader — the rest of the form follows."
                        android:textColor="#9AA0AC"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- ── Floating CREATE dock ── -->
    <LinearLayout
        android:id="@+id/vcreate_dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/csc_sheet"
        android:elevation="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/vcreate_dock_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Ready to create"
                android:textColor="#F4F6F9"
                android:textSize="13sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/vcreate_dock_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif"
                android:text="Pick a loader and version"
                android:textColor="#8A909C"
                android:textSize="10sp"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <TextView
            android:id="@+id/vcreate_create"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/csc_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:minWidth="150dp"
            android:paddingHorizontal="22dp"
            android:text="CREATE PROFILE"
            android:textColor="#141519"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
