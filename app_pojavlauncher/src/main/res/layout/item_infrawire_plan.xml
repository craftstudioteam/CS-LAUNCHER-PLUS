<?xml version="1.0" encoding="utf-8"?>
<!-- Single VPS plan row in the comparison list -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/infrawire_plan_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_infrawire_plan_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_plan_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mini"
            android:textColor="#F0F0F3"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_plan_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$4.83/month"
            android:textColor="#D0D0D0"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.6"
        android:orientation="horizontal"
        android:gravity="end|center_vertical">

        <TextView
            android:id="@+id/tv_plan_cpu"
            style="@style/InfrawireChip"
            android:text="1 vCore" />

        <TextView
            android:id="@+id/tv_plan_ram"
            style="@style/InfrawireChip"
            android:text="2 GB" />

        <TextView
            android:id="@+id/tv_plan_disk"
            style="@style/InfrawireChip"
            android:layout_marginEnd="0dp"
            android:text="10 GB NVMe" />
    </LinearLayout>

</LinearLayout>
