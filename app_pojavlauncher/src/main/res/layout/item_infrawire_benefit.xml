<?xml version="1.0" encoding="utf-8"?>
<!-- Single benefit tile in the 2-column grid -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/infrawire_benefit_tile"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_infrawire_benefit_tile"
    android:padding="12dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_infrawire_check"
        android:layout_marginEnd="10dp"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_benefit_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Benefit"
            android:textColor="#F0F0F3"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_benefit_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sub"
            android:textColor="#7C7C88"
            android:textSize="10sp"
            android:layout_marginTop="1dp" />
    </LinearLayout>

</LinearLayout>
