<?xml version="1.0" encoding="utf-8"?>
<!--
  ═══════════════════════════════════════════════════════════════════
  CS LAUNCHER PLUS — RUNTIME MANAGER SHEET (V4 REDESIGN)
  Bottom sheet modal for managing installed Java runtimes.
  ═══════════════════════════════════════════════════════════════════
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rt_sheet"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="20dp"
    android:paddingEnd="22dp"
    android:paddingBottom="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Java Runtime Manager"
                android:textColor="#F8FAFC"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Installed Java runtimes and custom JRE imports"
                android:textColor="#94A3B8"
                android:textSize="12.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/rt_dialog_close"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/rt_btn_ghost"
            android:gravity="center"
            android:text="✕"
            android:textColor="#CBD5E1"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- RecyclerView for installed runtimes -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rt_dialog_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxHeight="320dp"
        android:overScrollMode="never"
        android:scrollbars="none" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rt_dialog_edit"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/rt_btn_ghost"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/multirt_delete_runtime"
            android:textColor="#CBD5E1"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/rt_dialog_add"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/rt_btn_primary"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Add from File"
            android:textColor="#090A0E"
            android:textSize="13.5sp" />
    </LinearLayout>
</LinearLayout>
