<?xml version="1.0" encoding="utf-8"?>
<!-- Browse discovery — one placeholder card shown while results load.
     Same footprint as item_mod_modern.xml so the grid never jumps. A
     ShimmerOverlay sweeps a light band across the card (anime-style loop). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="246dp"
    android:layout_margin="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_mp_skeleton"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@drawable/bg_browse_skeleton_block" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:background="@drawable/bg_browse_skeleton_block" />

            <View
                android:layout_width="124dp"
                android:layout_height="10dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_browse_skeleton_block" />

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_browse_skeleton_block" />

            <View
                android:layout_width="96dp"
                android:layout_height="10dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_browse_skeleton_block" />

            <View
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_browse_skeleton_block" />
        </LinearLayout>
    </LinearLayout>

    <net.kdt.pojavlaunch.ui.ShimmerOverlay
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
