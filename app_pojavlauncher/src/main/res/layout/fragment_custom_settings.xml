<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     Phase 10 · SIMPLE SETTINGS
     One centred column, phone-style: big title, one search pill, then
     grouped cards of tall rows. No rail, no badges, no stats, no stars.
     Every id the fragment binds is preserved (rail / badge / icon are
     kept in the tree but GONE).
     ═══════════════════════════════════════════════════════════════════ -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ss_page">

    <!-- legacy rail (Phase 9) — kept for id compatibility, never shown -->
    <ScrollView
        android:id="@+id/settings_category_rail_scroll"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/settings_category_rail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/settings_rail_foot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <Space
        android:id="@+id/settings_dock_spacer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- ── the column ─────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/settings_column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical">

        <!-- title bar -->
        <LinearLayout
            android:id="@+id/settings_header_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp">

            <FrameLayout
                android:id="@+id/settings_back_button"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/ss_back_btn"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_back_white"
                    app:tint="#F4F6F9" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/settings_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Settings"
                    android:textColor="#F4F6F9"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/settings_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#8A909C"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <!-- kept for compatibility, hidden in the simple design -->
            <ImageView
                android:id="@+id/settings_header_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_menu_settings"
                android:visibility="gone"
                app:tint="#C9CED8" />

            <TextView
                android:id="@+id/settings_live_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>

        <!-- one search pill, full width -->
        <LinearLayout
            android:id="@+id/settings_search_pill"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/ss_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_cs_search"
                app:tint="#8A909C" />

            <EditText
                android:id="@+id/settings_search_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search settings"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="#F4F6F9"
                android:textColorHint="#5C6068"
                android:textSize="14sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/settings_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="96dp"
            android:scrollbars="none" />
    </LinearLayout>

    <!-- floating SAVE bar -->
    <LinearLayout
        android:id="@+id/unsaved_changes_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/ss_save_bar"
            android:elevation="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/ss_dot_ok" />

            <TextView
                android:id="@+id/save_status_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Unsaved changes"
                android:textColor="#E6E9EF"
                android:textSize="13.5sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_save_settings"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/ss_btn_primary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="22dp"
                android:stateListAnimator="@null"
                android:text="Save"
                android:textAllCaps="false"
                android:textColor="#141519"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
