<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     STOREFRONT CARD (Phase 9). Root LinearLayout + every id/type kept for
     ModItemAdapter: banner (mod_background_image_1/2) with scrim, docked
     icon frame, source badge, like/share, title/author/summary, tag chips,
     stats and INSTALL pill / installed-state pill.
     ═══════════════════════════════════════════════════════════════════ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mod_card_root"
    android:layout_width="match_parent"
    android:layout_height="252dp"
    android:layout_margin="5dp"
    android:background="@drawable/sf_card"
    android:clickable="true"
    android:clipChildren="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical">

    <!-- ── banner ── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="112dp">

        <ImageView
            android:id="@+id/mod_background_image_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/mod_background_image_2"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/sf_banner_scrim" />

        <!-- source badge (top-left) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_gravity="start|top"
            android:layout_margin="8dp"
            android:background="@drawable/sf_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/mod_source_imageview"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="monospace"
                android:text="SRC"
                android:textColor="#C9CED8"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- like / share (top-right) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_margin="6dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_share"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/sf_round_btn"
                android:contentDescription="@null"
                android:padding="7dp"
                android:src="@drawable/ic_menu_share"
                app:tint="#E6E9EF" />

            <ImageButton
                android:id="@+id/btn_like"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/sf_round_btn"
                android:contentDescription="@null"
                android:padding="7dp"
                android:src="@drawable/ic_heart_outline"
                app:tint="#E6E9EF" />
        </LinearLayout>

        <!-- docked icon frame (bottom-left, overlaps the body) -->
        <FrameLayout
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="start|bottom"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="-4dp"
            android:background="@drawable/sf_icon_frame"
            android:elevation="4dp"
            android:padding="3dp">

            <ImageView
                android:id="@+id/mod_thumbnail_imageview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_profile_icon_rounded"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />
        </FrameLayout>
    </FrameLayout>

    <!-- ── body ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="9dp">

        <!-- title row (indented past the docked icon) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="58dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mod_title_textview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="#F4F6F9"
                android:textSize="13.5sp"
                tools:text="Fabulously Optimized" />

            <TextView
                android:id="@+id/mod_info_textview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textColor="#7F8593"
                android:textSize="9.5sp"
                tools:text="by robotkoer  ·  1.21" />
        </LinearLayout>

        <TextView
            android:id="@+id/mod_body_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.12"
            android:maxLines="2"
            android:textColor="#9AA0AC"
            android:textSize="10.5sp"
            tools:text="A simple, performance-focused modpack." />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/mod_tags_container"
            android:layout_width="match_parent"
            android:layout_height="19dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone" />

        <!-- footer: stats · action -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mod_downloads_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawablePadding="4dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textColor="#C9CED8"
                android:textSize="10sp"
                app:drawableStartCompat="@drawable/ic_sf_dl"
                tools:text="4.2M" />

            <TextView
                android:id="@+id/mod_followers_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:drawablePadding="4dp"
                android:fontFamily="monospace"
                android:gravity="center_vertical"
                android:textColor="#C9CED8"
                android:textSize="10sp"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_sf_heart"
                tools:text="12k"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/btn_install"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/sf_install_pill"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:minWidth="76dp"
                android:paddingHorizontal="12dp"
                android:text="INSTALL"
                android:textColor="#141519"
                android:textSize="9.5sp" />

            <LinearLayout
                android:id="@+id/mod_install_state_pill"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_cs_installed_pill"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/mod_install_state_icon"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check" />

                <TextView
                    android:id="@+id/mod_install_state_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:textColor="#D2D6DE"
                    android:textSize="9sp"
                    tools:text="INSTALLED" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
