<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 10 simple settings row (toggle). ids preserved. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ss_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="62dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/setting_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="14dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_menu_settings"
        app:tint="#9AA0AC" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/setting_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F4F6F9"
            android:textSize="15.5sp" />

        <TextView
            android:id="@+id/setting_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#8A909C"
            android:textSize="12.5sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/setting_fav_star"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:background="@null"
        android:contentDescription="@string/cs_settings_fav_add"
        android:src="@drawable/ic_csp_star_outline"
        android:visibility="gone" />

    <net.kdt.pojavlaunch.prefs.CustomToggleView
        android:id="@+id/setting_toggle"
        android:layout_width="52dp"
        android:layout_height="30dp" />
</LinearLayout>
