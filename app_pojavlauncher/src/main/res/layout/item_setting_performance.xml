<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 9: live memory telemetry sheet. ids: perf_native_value, perf_java_value, perf_device_value, perf_meter_fill, perf_meter_spacer -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="4dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/st_icon_well">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_settings_performance"
                app:tint="#C9CED8" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Memory telemetry"
                android:textColor="#F4F6F9"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PSS-accurate, refreshed every second"
                android:textColor="#7F8593"
                android:textSize="10.5sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:background="@drawable/st_key_cap"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:text="● LIVE"
            android:textColor="#C9CED8"
            android:textSize="8.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/st_stat_tile"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="LAUNCHER"
                android:textColor="#6B7180"
                android:textSize="8.5sp" />

            <TextView
                android:id="@+id/perf_native_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="monospace"
                android:text="—"
                android:textColor="#F4F6F9"
                android:textSize="17sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/st_stat_tile"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="GAME HEAP"
                android:textColor="#6B7180"
                android:textSize="8.5sp" />

            <TextView
                android:id="@+id/perf_java_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="monospace"
                android:text="—"
                android:textColor="#F4F6F9"
                android:textSize="17sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/st_stat_tile"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="SYSTEM FREE"
                android:textColor="#6B7180"
                android:textSize="8.5sp" />

            <TextView
                android:id="@+id/perf_device_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="monospace"
                android:text="—"
                android:textColor="#F4F6F9"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- device memory pressure meter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/st_meter_track"
        android:orientation="horizontal">

        <View
            android:id="@+id/perf_meter_fill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:background="@drawable/st_meter_fill" />

        <View
            android:id="@+id/perf_meter_spacer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="100" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:letterSpacing="0.14"
        android:text="ENGINE METRICS"
        android:textColor="#5C6068"
        android:textSize="8.5sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/st_stat_tile"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="9dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Thermals"
                android:textColor="#9AA0AC"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:background="@drawable/st_key_cap"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingHorizontal="5dp"
                android:text="SOON"
                android:textColor="#5C6068"
                android:textSize="8sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/st_stat_tile"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="9dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Frame pacing"
                android:textColor="#9AA0AC"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:background="@drawable/st_key_cap"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingHorizontal="5dp"
                android:text="SOON"
                android:textColor="#5C6068"
                android:textSize="8sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/st_stat_tile"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="9dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GPU load"
                android:textColor="#9AA0AC"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:background="@drawable/st_key_cap"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingHorizontal="5dp"
                android:text="SOON"
                android:textColor="#5C6068"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
