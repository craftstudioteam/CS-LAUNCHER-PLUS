<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     ELY.BY WEB SHEET (Phase 9) — status bar (back key-cap · glyph · title
     · url · refresh) over a framed WebView.
     Ids kept: btn_elyby_browser_back, btn_elyby_browser_refresh, elyby_browser_webview
     ═══════════════════════════════════════════════════════════════════ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/au9_page"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/au9_statusbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/btn_elyby_browser_back"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/au9_btn_ghost"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:paddingHorizontal="12dp"
            android:text="←  BACK"
            android:textColor="#E6E9EF"
            android:textSize="10.5sp" />

        <FrameLayout
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/au9_icon_well">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_auth_elyby" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="ely.by  ·  account &amp; skins"
                android:textColor="#F4F6F9"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="https://ely.by"
                android:textColor="#5C6068"
                android:textSize="9.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_elyby_browser_refresh"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/au9_btn_ghost"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:paddingHorizontal="12dp"
            android:text="↻  RELOAD"
            android:textColor="#E6E9EF"
            android:textSize="10.5sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="10dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/au9_webframe"
            android:clipToOutline="true"
            android:padding="1dp">

            <WebView
                android:id="@+id/elyby_browser_webview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
