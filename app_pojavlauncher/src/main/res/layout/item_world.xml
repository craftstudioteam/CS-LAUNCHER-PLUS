<?xml version="1.0" encoding="utf-8"?>
<!-- WORLD CARD — compact premium grid card (mobile-first, shows more worlds
     per screen). All view IDs preserved for WorldListAdapter (R5). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_cs_glass_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:minHeight="82dp"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- ── Top row: art icon + name/actions ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_cs_world_icon"
            android:padding="3dp">

            <ImageView
                android:id="@+id/world_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cs_world_icon_desc"
                android:scaleType="centerCrop"
                tools:src="@tools:sample/avatars" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/world_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/minecraftia"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                tools:text="My Survival Base" />

            <TextView
                android:id="@+id/world_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#9CA3AF"
                android:textSize="9.5sp"
                tools:text="1.20.1  •  2d ago" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/world_menu_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cs_world_actions"
            android:padding="7dp"
            android:src="@drawable/ic_cs_more"
            app:tint="#9CA3AF" />
    </LinearLayout>

    <!-- ── Bottom row: chips ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/world_size_chip"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:background="@drawable/bg_cs_chip"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:textColor="#9CA3AF"
            android:textSize="9sp"
            android:textStyle="bold"
            tools:text="842 MB" />

        <TextView
            android:id="@+id/world_datapack_chip"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_cs_chip_accent"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="3 datapacks" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

</LinearLayout>
