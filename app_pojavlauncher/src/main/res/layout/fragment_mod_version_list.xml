<?xml version="1.0" encoding="utf-8"?>
<!-- ════════════════════════════════════════════════════════════════
     LOADER INSTALLER v2 — Mobile-first premium redesign
     • Compact top chrome
     • Full-height version list with overlay retry state
     • Premium ready-to-install hero card
     • Sticky bottom CTA
     • Theme/colors unchanged
     • All functional IDs preserved
     ════════════════════════════════════════════════════════════════ -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mp_page"
    android:fitsSystemWindows="true">

    <ViewFlipper
        android:id="@+id/mod_dl_step_flipper"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:inAnimation="@anim/slide_in_up"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- ═══════════ SCREEN 1: VERSION LIST ═══════════ -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Compact premium header -->
            <LinearLayout
                android:id="@+id/internal_step1_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_mp_header"
                android:elevation="6dp"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingTop="14dp"
                android:paddingBottom="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.14"
                    android:text="@string/loader_installer_eyebrow"
                    android:textColor="#7C7C88"
                    android:textSize="8.8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/title_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/minecraftia"
                    android:includeFontPadding="false"
                    android:text="@string/forge_dl_select_version"
                    android:textColor="#F0F0F3"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/loader_installer_sub"
                    android:textColor="#9C9CA8"
                    android:textSize="11sp" />

                <ProgressBar
                    android:id="@+id/mod_dl_list_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="10dp"
                    android:indeterminate="true"
                    android:indeterminateTint="#FFFFFF"
                    android:progressBackgroundTint="#23232B"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Body container -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/internal_step1_header">

                <!-- Version list takes full remaining height -->
                <ExpandableListView
                    android:id="@+id/mod_dl_expandable_version_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:cacheColorHint="@android:color/transparent"
                    android:childDivider="@android:color/transparent"
                    android:clipToPadding="false"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="0dp"
                    android:groupIndicator="@null"
                    android:overScrollMode="ifContentScrolls"
                    android:paddingStart="4dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="14dp"
                    android:scrollbars="vertical" />

                <!-- Retry shown as centered overlay card -->
                <LinearLayout
                    android:id="@+id/mod_dl_retry_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="12dp"
                    android:background="@drawable/bg_mp_section"
                    android:elevation="4dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_mp_icon_tile">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_download_trend"
                            app:tint="#E5A0A6" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="@string/modloader_dl_failed_to_load_list"
                        android:textColor="#E5A0A6"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Please check your connection and try again."
                        android:textColor="#9C9CA8"
                        android:textSize="10.5sp" />

                    <Button
                        android:id="@+id/forge_installer_retry_button"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_mp_cta"
                        android:stateListAnimator="@null"
                        android:text="@string/global_retry"
                        android:textAllCaps="true"
                        android:textColor="#0E0E11"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ═══════════ SCREEN 2: READY TO INSTALL ═══════════ -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Header -->
            <LinearLayout
                android:id="@+id/internal_step2_header"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_mp_header"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageButton
                    android:id="@+id/mod_dl_step2_back_btn"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_mp_filter"
                    android:contentDescription="@string/global_back"
                    android:padding="10dp"
                    android:src="@drawable/ic_arrow_back_white"
                    app:tint="#FFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/minecraftia"
                        android:includeFontPadding="false"
                        android:text="@string/loader_installer_ready_title"
                        android:textColor="#F0F0F3"
                        android:textSize="15.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Review the selected loader before install"
                        android:textColor="#9C9CA8"
                        android:textSize="9.8sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Scrollable middle content -->
            <androidx.core.widget.NestedScrollView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="ifContentScrolls"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="16dp"
                app:layout_constraintBottom_toTopOf="@id/internal_step2_cta"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/internal_step2_header">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <!-- Hero summary card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_mp_hero_card"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <FrameLayout
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_mp_icon_tile">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_download_trend"
                                app:tint="#FFFFFF" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/loader_installer_summary_title"
                            android:textColor="#F0F0F3"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="@string/loader_installer_summary_sub"
                            android:textColor="#9C9CA8"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/mod_dl_label_version"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_mp_version_badge"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="7dp"
                            android:textColor="#0E0E11"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="Forge 47.2.0" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="12dp" />

                    <!-- Info card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_mp_section"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="What happens next"
                            android:textColor="#F0F0F3"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="• Required installer files will be downloaded automatically"
                            android:textColor="#9C9CA8"
                            android:textSize="10.8sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="• Version-specific data will be prepared for your selected game version"
                            android:textColor="#9C9CA8"
                            android:textSize="10.8sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="• Installation may take a moment depending on network speed"
                            android:textColor="#9C9CA8"
                            android:textSize="10.8sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="12dp" />

                    <!-- Safety / note card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_mp_section"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_mp_icon_tile">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_download_trend"
                                app:tint="#9C9CA8" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tip"
                                android:textColor="#F0F0F3"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="If this loader supports multiple branches, choose the one matching your Minecraft version exactly."
                                android:textColor="#9C9CA8"
                                android:textSize="10.5sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Sticky CTA -->
            <FrameLayout
                android:id="@+id/internal_step2_cta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="#F2141419"
                android:elevation="12dp"
                android:paddingHorizontal="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <Button
                    android:id="@+id/mod_dl_start_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_mp_cta"
                    android:letterSpacing="0.06"
                    android:stateListAnimator="@null"
                    android:text="@string/loader_installer_start"
                    android:textAllCaps="true"
                    android:textColor="#0E0E11"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ViewFlipper>
</androidx.constraintlayout.widget.ConstraintLayout>
