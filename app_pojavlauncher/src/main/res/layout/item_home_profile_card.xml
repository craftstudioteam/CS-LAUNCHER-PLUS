<?xml version="1.0" encoding="utf-8"?>
<!-- ✦ Premium profile card — layered charcoal, GIF banner, ring icon, refined type -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_profile_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="5dp"
    android:layout_marginVertical="5dp"
    android:background="@drawable/bg_profile_card"
    android:stateListAnimator="@animator/card_press_anim"
    android:clipChildren="true"
    android:clipToOutline="true"
    android:clickable="true"
    android:focusable="true">

    <!-- Background image / animated GIF fills the card -->
    <ImageView
        android:id="@+id/img_profile_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- Gradient scrim: lets the banner breathe, content stays readable -->
    <View
        android:id="@+id/img_profile_background_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_profile_card_scrim"
        android:visibility="gone" />

    <!-- ✦ Premium MC-version badge, pinned top-right (Req-9) -->
    <TextView
        android:id="@+id/tv_version_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_cs_version_badge"
        android:elevation="2dp"
        android:minWidth="54dp"
        android:maxWidth="82dp"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:textColor="#F0F0F2"
        android:textSize="10sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.06"
        android:maxLines="1"
        android:visibility="gone" />

    <!-- Favorite state is independent from launch selection. -->
    <ImageButton
        android:id="@+id/btn_profile_favorite"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="92dp"
        android:background="@drawable/bg_browse_button"
        android:contentDescription="Favorite profile"
        android:padding="7dp"
        android:src="@drawable/ic_csp_star_outline"
        android:tint="#A9ABB4" />

    <!-- Main content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Identity row (end padding reserves the corner space for the
             floating MC-version badge so long names never run under it) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="136dp"
            android:paddingTop="13dp"
            android:paddingBottom="7dp">

            <!-- Profile icon with luminous ring -->
            <ImageView
                android:id="@+id/img_profile_icon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="11dp"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:background="@drawable/bg_profile_icon_rounded" />

            <!-- Profile text stack -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_profile_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#F4F4F8"
                    android:textSize="15sp"
                    android:fontFamily="@font/minecraftia"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/tv_profile_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#9C9CA8"
                    android:textSize="10sp"
                    android:letterSpacing="0.02"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:layout_marginTop="2dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="3dp">

                    <TextView
                        android:id="@+id/tv_profile_mod_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent_primary"
                        android:textSize="9.5sp"
                        android:fontFamily="sans-serif-medium"
                        android:ellipsize="end"
                        android:maxLines="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  •  "
                        android:textColor="#4A4A54"
                        android:textSize="9.5sp" />

                    <TextView
                        android:id="@+id/tv_profile_ram"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#7C7C88"
                        android:textSize="9.5sp"
                        android:ellipsize="end"
                        android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Hairline divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.8dp"
            android:background="#1FFFFFFF"
            android:layout_marginHorizontal="12dp" />

        <!-- Action row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp">

            <!-- Add to Home Screen -->
            <FrameLayout
                android:id="@+id/btn_profile_shortcut"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_browse_button"
                android:stateListAnimator="@animator/card_press_anim"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/shortcut_add_title">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_shortcut_add"
                    android:tint="@color/premium_cyan" />
            </FrameLayout>

            <!-- Dedicated reorder handle. Only this view can start a drag. -->
            <FrameLayout
                android:id="@+id/btn_profile_drag"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_browse_button"
                android:clickable="true"
                android:contentDescription="Hold and drag to reorder profile"
                android:focusable="true"
                android:stateListAnimator="@animator/card_press_anim">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_profile_drag_handle"
                    android:tint="#B9BBC4" />
            </FrameLayout>

            <!-- Browse Resources -->
            <FrameLayout
                android:id="@+id/btn_profile_browse"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_browse_button"
                android:stateListAnimator="@animator/card_press_anim"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_profile_download"
                    android:tint="#D9DAE0" />
            </FrameLayout>

            <!-- Play — Phase 3 premium launch morph (wave + glow + particles) -->
            <net.kdt.pojavlaunch.ui.PremiumPlayButtonView
                android:id="@+id/btn_profile_play"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1.1"
                android:layout_marginStart="5dp"
                android:contentDescription="@string/cs_world_play">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play_arrow"
                    android:tint="#0E0E11" />
            </net.kdt.pojavlaunch.ui.PremiumPlayButtonView>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
