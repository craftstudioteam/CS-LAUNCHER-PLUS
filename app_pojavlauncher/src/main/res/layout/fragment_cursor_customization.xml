<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     CURSOR STUDIO v5 — "Clean Console" (same design language as the
     Profile Editor v5). Slim command bar with ALL actions inline
     (Reset / Export / Save), LEFT live preview stage, RIGHT flat
     tuning column. All fragment IDs + widget types preserved.
     ═══════════════════════════════════════════════════════════════════ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pe4_page_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingTop="18dp"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    android:orientation="vertical">

    <!-- Invisible spacer line: hard-guarantees the command bar sits BELOW the
         screen edge / camera cutout on every device, even if inset APIs lie. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:background="@android:color/transparent" />

    <!-- ── COMMAND BAR ──────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/cursor_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:background="@drawable/pe5_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/cursor_back_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/pe4_back_btn"
            android:contentDescription="@string/global_back"
            android:padding="10dp"
            android:src="@drawable/ic_chevron_left"
            app:tint="#EAECEF" />

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/pe4_icon_well">
            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_mouse_pointer"
                app:tint="#E6E8EE" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CUSTOMIZE"
                android:textColor="#7C828E"
                android:textSize="7.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.2" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Cursor Studio"
                android:textColor="#FFFFFF"
                android:textSize="14.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_favorite_cursor"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/pe4_btn_ghost"
            android:contentDescription="Favorite"
            android:padding="9dp"
            android:src="@drawable/ic_heart_outline"
            app:tint="#9AA0AE" />

        <TextView
            android:id="@+id/btn_save_cursor"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="16dp"
            android:background="@drawable/pe4_btn_save"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:text="SAVE &amp; APPLY"
            android:textColor="#14151A"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ── BODY: preview | tuning ───────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- ═══ LEFT: live preview stage ═══ -->
        <LinearLayout
            android:id="@+id/cursorx_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="14dp"
            android:layout_weight="0.95"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/cursor_preview_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_cursorx_stage">

                <TextView
                    android:id="@+id/cursor_preview_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_cursorx_chip"
                    android:letterSpacing="0.12"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="LIVE PREVIEW"
                    android:textColor="#F0F1F5"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cursor_preview_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="14dp"
                    android:letterSpacing="0.06"
                    android:text="ACTIVE"
                    android:textColor="#C6CAD3"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/cursor_preview_image"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:layout_gravity="center"
                    android:contentDescription="Cursor preview"
                    android:src="@drawable/ic_mouse_pointer" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:id="@+id/cursor_pack_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Classic Pointer"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/cursor_pack_creator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CS"
                            android:textColor="#B9BEC9"
                            android:textSize="10.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="6dp"
                            android:text="·"
                            android:textColor="#5C6070"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/cursor_pack_category"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.06"
                            android:text="SYSTEM"
                            android:textColor="#9AA0AE"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Reset / Export under the preview (never crowds the top bar) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_reset_cursor"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/pe4_btn_ghost"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:text="RESET"
                    android:textColor="#B9BEC9"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_export_cursor"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/pe4_btn_ghost"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:text="EXPORT"
                    android:textColor="#B9BEC9"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#1AFFFFFF" />

        <!-- ═══ RIGHT: flat tuning column ═══ -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/cursorx_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_weight="1.05"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutAnimation="@anim/cz_cascade"
                android:orientation="vertical"
                android:paddingBottom="10dp">

                <!-- QUICK STYLE -->
                <TextView
                    style="@style/Pe5Label"
                    android:layout_marginTop="2dp"
                    android:text="Quick Style" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/style_classic"
                        android:layout_width="0dp"
                        android:layout_height="66dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_cursorx_style"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_mouse_pointer"
                            app:tint="#C6CAD3" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:letterSpacing="0.08"
                            android:text="CLASSIC"
                            android:textColor="#F0F1F5"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/style_gamepad"
                        android:layout_width="0dp"
                        android:layout_height="66dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_cursorx_style"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_menu_custom_controls"
                            app:tint="#C6CAD3" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:letterSpacing="0.08"
                            android:text="GAMEPAD"
                            android:textColor="#F0F1F5"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/style_custom"
                        android:layout_width="0dp"
                        android:layout_height="66dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_cursorx_style"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_edit_profile"
                            app:tint="#C6CAD3" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:letterSpacing="0.08"
                            android:text="CUSTOM"
                            android:textColor="#F0F1F5"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- TUNING (flat rows, no card) -->
                <TextView style="@style/Pe5Label" android:text="Tuning" />

                <LinearLayout style="@style/CursorXRowHead" android:layout_marginTop="10dp">
                    <TextView style="@style/CursorXRowTitle" android:text="SIZE" />
                    <TextView android:id="@+id/scale_value_text" style="@style/CursorXRowValue" android:text="100%" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/seek_cursor_size"
                    style="@style/CursorXSeek"
                    android:max="200"
                    android:progress="100" />

                <LinearLayout style="@style/CursorXRowHead" android:layout_marginTop="14dp">
                    <TextView style="@style/CursorXRowTitle" android:text="OPACITY" />
                    <TextView android:id="@+id/opacity_value_text" style="@style/CursorXRowValue" android:text="100%" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/seek_cursor_opacity"
                    style="@style/CursorXSeek"
                    android:max="100"
                    android:progress="100" />

                <LinearLayout style="@style/CursorXRowHead" android:layout_marginTop="14dp">
                    <TextView style="@style/CursorXRowTitle" android:text="ANIMATION SPEED" />
                    <TextView android:id="@+id/anim_speed_value" style="@style/CursorXRowValue" android:text="1.0×" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/seek_anim_speed"
                    style="@style/CursorXSeek"
                    android:max="200"
                    android:progress="100" />

                <LinearLayout style="@style/CursorXRowHead" android:layout_marginTop="14dp">
                    <TextView style="@style/CursorXRowTitle" android:text="GLOW STRENGTH" />
                    <TextView android:id="@+id/glow_value_text" style="@style/CursorXRowValue" android:text="0" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/seek_glow_strength"
                    style="@style/CursorXSeek"
                    android:max="30"
                    android:progress="0" />

                <!-- GLOW COLOR -->
                <TextView style="@style/Pe5Label" android:text="Glow Color" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <ImageView android:id="@+id/color_green" style="@style/CsColorSwatch" android:backgroundTint="#A6FF3D" android:contentDescription="@null" />
                        <ImageView android:id="@+id/color_cyan" style="@style/CsColorSwatch" android:backgroundTint="#22C9CB" android:contentDescription="@null" />
                        <ImageView android:id="@+id/color_purple" style="@style/CsColorSwatch" android:backgroundTint="#8B5CF6" android:contentDescription="@null" />
                        <ImageView android:id="@+id/color_red" style="@style/CsColorSwatch" android:backgroundTint="#FF3D00" android:contentDescription="@null" />
                        <ImageView android:id="@+id/color_yellow" style="@style/CsColorSwatch" android:backgroundTint="#FFEA00" android:contentDescription="@null" />
                        <ImageView android:id="@+id/color_white" style="@style/CsColorSwatch" android:backgroundTint="#FFFFFF" android:contentDescription="@null" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- CURSOR PACKS -->
                <TextView style="@style/Pe5Label" android:text="Cursor Packs" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/cursor_cat_chips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <GridLayout
                    android:id="@+id/cursor_pack_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:columnCount="2"
                    android:orientation="horizontal"
                    android:useDefaultMargins="false" />

                <!-- IMPORT -->
                <FrameLayout
                    android:id="@+id/upload_zone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_cursorx_upload"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="18dp">
                    <TextView
                        android:id="@+id/btn_import_png"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:letterSpacing="0.1"
                        android:text="＋  IMPORT PNG  ·  MAKE IT YOURS"
                        android:textColor="#C6CAD3"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</LinearLayout>
