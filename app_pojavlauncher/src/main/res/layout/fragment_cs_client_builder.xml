<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     CS CLIENT • GRAPHITE v2 — PROFILE BUILDER / PORTRAIT (brand-new layout)
     Step rail → compact summary card → manifest → floating action dock.
     IDs + View types preserved:
       csc_builder_back(View), csc_builder_identity(LinearLayout),
       csc_builder_version(TextView), csc_builder_build(TextView),
       csc_stat_modules/loader/pack (TextView), csc_selection_chips(LinearLayout),
       csc_browse_mods / csc_browse_pack / csc_create_profile (TextView)
     ═══════════════════════════════════════════════════════════════════ -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/csc_page"
    android:animateLayoutChanges="true">

    <View
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@drawable/csc_bloom"
        android:alpha="0.6" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ── Command bar ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/csc_topbar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/csc_builder_back"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/csc_btn_back"
                android:clickable="true"
                android:contentDescription="Back"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="‹"
                android:textColor="#D2D6DE"
                android:textSize="26sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Profile Architect"
                    android:textColor="#F4F6F9"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:text="STEP 2 OF 3  •  BUILD PROFILE"
                    android:textColor="#9AA0AC"
                    android:textSize="9sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/csc_icon_well">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="CS Client"
                    android:src="@drawable/cs_logo"
                    app:tint="#D2D6DE" />
            </FrameLayout>
        </LinearLayout>

        <!-- ── Step rail ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="22dp"
            android:paddingTop="14dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/csc_step_done"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="✓"
                android:textColor="#141519"
                android:textSize="14sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:background="@drawable/csc_accent_bar" />

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/csc_step_active"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="2"
                android:textColor="#E6E9EF"
                android:textSize="13sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:background="@drawable/csc_step_line" />

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/csc_step_idle"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="3"
                android:textColor="#8A8F99"
                android:textSize="13sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="180dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- ── Summary / identity card ── -->
                    <LinearLayout
                        android:id="@+id/csc_builder_identity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/csc_card"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/csc_medallion">
                                <ImageView
                                    android:layout_width="34dp"
                                    android:layout_height="34dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="CS Client"
                                    android:src="@drawable/cs_logo"
                                    app:tint="#E6E9EF" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:letterSpacing="0.03"
                                    android:text="CS CLIENT PROFILE"
                                    android:textColor="#F4F6F9"
                                    android:textSize="16sp" />

                                <TextView
                                    android:id="@+id/csc_builder_version"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:fontFamily="sans-serif"
                                    android:textColor="#9AA0AC"
                                    android:textSize="11sp"
                                    tools:text="MINECRAFT 1.21" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/csc_builder_build"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/csc_chip_idle"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:letterSpacing="0.03"
                            android:paddingVertical="10dp"
                            android:textColor="#C4C9D2"
                            android:textSize="11sp"
                            tools:text="CS CLIENT 1.0  •  FABRIC" />

                        <!-- Inline stat chips -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/csc_stat_tile"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingVertical="14dp">

                                <TextView
                                    android:id="@+id/csc_stat_modules"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:includeFontPadding="false"
                                    android:textColor="#F4F6F9"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    tools:text="3" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:fontFamily="sans-serif-medium"
                                    android:letterSpacing="0.08"
                                    android:text="MODULES"
                                    android:textColor="#9AA0AC"
                                    android:textSize="8sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:background="@drawable/csc_stat_tile"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingVertical="14dp">

                                <TextView
                                    android:id="@+id/csc_stat_loader"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:includeFontPadding="false"
                                    android:textColor="#D2D6DE"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    tools:text="FABRIC" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:fontFamily="sans-serif-medium"
                                    android:letterSpacing="0.08"
                                    android:text="LOADER"
                                    android:textColor="#9AA0AC"
                                    android:textSize="8sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:background="@drawable/csc_stat_tile"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingVertical="14dp">

                                <TextView
                                    android:id="@+id/csc_stat_pack"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:includeFontPadding="false"
                                    android:textColor="#C9CED8"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    tools:text="NONE" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:fontFamily="sans-serif-medium"
                                    android:letterSpacing="0.08"
                                    android:text="MODPACK"
                                    android:textColor="#9AA0AC"
                                    android:textSize="8sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ── Manifest card ── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/csc_card"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="4dp"
                                android:layout_height="16dp"
                                android:background="@drawable/csc_accent_bar" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.06"
                                android:text="WHAT WILL BE INSTALLED"
                                android:textColor="#F4F6F9"
                                android:textSize="13sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="tap × to remove"
                                android:textColor="#7A808C"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/csc_selection_chips"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <!-- ── Add content (secondary actions) ── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/csc_browse_mods"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="1"
                            android:background="@drawable/csc_btn_ghost"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:letterSpacing="0.04"
                            android:text="＋  BROWSE MODS"
                            android:textColor="#D2D6DE"
                            android:textSize="11sp"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:id="@+id/csc_browse_pack"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/csc_btn_ghost"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:letterSpacing="0.04"
                            android:text="SELECT MODPACK"
                            android:textColor="#D2D6DE"
                            android:textSize="11sp"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- ── Floating primary action dock ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/csc_sheet"
                android:elevation="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:paddingVertical="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Ready to build"
                        android:textColor="#F4F6F9"
                        android:textSize="13sp"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="sans-serif"
                        android:text="Atomic install • verified files"
                        android:textColor="#8A909C"
                        android:textSize="10sp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <TextView
                    android:id="@+id/csc_create_profile"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/csc_btn_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:letterSpacing="0.05"
                    android:minWidth="150dp"
                    android:paddingHorizontal="22dp"
                    android:text="CREATE"
                    android:textColor="#141519"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
