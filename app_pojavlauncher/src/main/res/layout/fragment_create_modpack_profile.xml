<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     MODPACK PROFILES v5 — "Clean Console"
     Slim command bar → two big, obvious action cards (Browse / Import)
     → quick tip. Same design family as Profile Editor / Cursor Studio /
     Settings v5. All ModpackCreateFragment IDs preserved.
     ═══════════════════════════════════════════════════════════════════ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pe4_page_bg"
    android:orientation="vertical">

    <!-- ── COMMAND BAR ──────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/profile_header"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/pe5_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <FrameLayout
            android:id="@+id/mp_back_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/pe4_back_btn"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:contentDescription="@string/global_back"
                android:src="@drawable/ic_chevron_left"
                app:tint="#EAECEF" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CREATE PROFILE"
                android:textColor="#7C828E"
                android:textSize="7.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.2" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Modpack Profiles"
                android:textColor="#FFFFFF"
                android:textSize="14.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutAnimation="@anim/cz_cascade"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/Pe5Title"
                android:text="How do you want to add a modpack?" />
            <TextView
                style="@style/Pe5Desc"
                android:text="Discover packs online, or install one directly from your device storage." />

            <LinearLayout
                android:id="@+id/button_browse_modpacks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_cursorx_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:id="@+id/internal_browse_well"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/pe4_icon_well">
                    <ImageView
                        android:id="@+id/browse_icon"
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search"
                        app:tint="#E6E8EE" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/internal_browse_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Browse Modpacks"
                        android:textColor="#FFFFFF"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/internal_browse_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Search, discover and install curated modpacks from supported sources."
                        android:textColor="#8D93A1"
                        android:textSize="10.5sp"
                        android:lineSpacingExtra="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_cursorx_chip"
                        android:gravity="center"
                        android:letterSpacing="0.1"
                        android:paddingHorizontal="9dp"
                        android:text="DISCOVER  •  INSTALL"
                        android:textColor="#C6CAD3"
                        android:textSize="7.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/internal_browse_arrow"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="10dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#7C828E" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/button_import_modpack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_cursorx_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:id="@+id/internal_import_well"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/pe4_icon_well">
                    <ImageView
                        android:id="@+id/import_icon"
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_folder"
                        app:tint="#E6E8EE" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/internal_import_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Import Zip or mrpack"
                        android:textColor="#FFFFFF"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/internal_import_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Install a modpack from device storage using a local .zip or .mrpack file."
                        android:textColor="#8D93A1"
                        android:textSize="10.5sp"
                        android:lineSpacingExtra="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_cursorx_chip"
                        android:gravity="center"
                        android:letterSpacing="0.1"
                        android:paddingHorizontal="9dp"
                        android:text="LOCAL FILE INSTALL"
                        android:textColor="#C6CAD3"
                        android:textSize="7.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/internal_import_arrow"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="10dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#7C828E" />
            </LinearLayout>

            <!-- Quick tip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_cursorx_upload"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="13dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:background="@drawable/pe4_chip_green"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:paddingHorizontal="9dp"
                    android:text="TIP"
                    android:textColor="#14151A"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    android:text="Use .mrpack for Modrinth packs and .zip for exported packs from other launchers."
                    android:textColor="#8D93A1"
                    android:textSize="10sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
