<?xml version="1.0" encoding="utf-8"?>
<!-- Settings Hub category — compact horizontal landscape card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="84dp"
    android:background="@drawable/bg_settings_studio_category"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="11dp">

    <FrameLayout
        android:id="@+id/category_card_icon_well"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/bg_settings_studio_icon">

        <ImageView
            android:id="@+id/category_card_icon"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_menu_settings"
            app:tint="#EDEDF2" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/category_card_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="#F3F3F7"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/category_card_badge"
                android:layout_width="wrap_content"
                android:layout_height="19dp"
                android:background="@drawable/bg_settings_studio_badge"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:minWidth="34dp"
                android:paddingHorizontal="7dp"
                android:textColor="#C8C9D0"
                android:textSize="7.5sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/category_card_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:textColor="#858792"
            android:textSize="9.5sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="9dp"
        android:background="@drawable/bg_s4h_chevron_well">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            app:tint="#AEB0BA" />
    </FrameLayout>
</LinearLayout>
