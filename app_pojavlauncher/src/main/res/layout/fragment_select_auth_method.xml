<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     IDENTITY TERMINAL (Phase 9) — sign-in method chooser.
     LEFT  : terminal card (glyph · kicker · title · what each account can do)
     RIGHT : provider rows (icon well · name · capability · key-cap → )
     Ids kept: auth_aura, auth_header, auth_title, card_auth_container,
     button_microsoft_authentication, button_elyby_authentication,
     button_local_authentication, auth_footnote
     ═══════════════════════════════════════════════════════════════════ -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/au9_page">

    <View
        android:id="@+id/auth_aura"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:minHeight="300dp"
            android:orientation="horizontal"
            android:paddingHorizontal="22dp"
            android:paddingVertical="16dp">

            <!-- LEFT: terminal card -->
            <LinearLayout
                android:id="@+id/auth_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.95"
                android:background="@drawable/au9_terminal"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/au9_icon_well"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="ID"
                        android:textColor="#F4F6F9"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.18"
                        android:text="IDENTITY  ·  SIGN IN"
                        android:textColor="#8A909C"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/auth_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Who is playing?"
                    android:textColor="#F4F6F9"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.2"
                    android:text="Pick how this launcher should identify you. You can add more accounts later from the account switcher."
                    android:textColor="#9AA0AC"
                    android:textSize="12sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="#22252D" />

                <!-- capability ledger -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <TextView style="@style/Au9Ledger" android:text="●  Microsoft   — servers · skins · capes" />
                    <TextView style="@style/Au9Ledger" android:text="●  ely.by      — free skins · many servers" />
                    <TextView style="@style/Au9Ledger" android:text="○  Local       — offline / LAN only" />
                </LinearLayout>
            </LinearLayout>

            <!-- RIGHT: provider rows -->
            <LinearLayout
                android:id="@+id/card_auth_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_weight="1.05"
                android:orientation="vertical">

                <!-- Microsoft (primary) -->
                <LinearLayout
                    android:id="@+id/button_microsoft_authentication"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/au9_provider_row_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="70dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/au9_icon_well_dark">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_auth_microsoft" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Microsoft account"
                            android:textColor="#141519"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Premium · full online play"
                            android:textColor="#3F434D"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:background="@drawable/au9_icon_well_dark"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:text="1  →"
                        android:textColor="#E6E9EF"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <!-- ely.by -->
                <LinearLayout
                    android:id="@+id/button_elyby_authentication"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/au9_provider_row"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="70dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/au9_icon_well">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_auth_elyby" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="ely.by account"
                            android:textColor="#F4F6F9"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Free · skins &amp; capes, ely-enabled servers"
                            android:textColor="#8A909C"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:background="@drawable/au9_keycap"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:text="2  →"
                        android:textColor="#C9CED8"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <!-- Local -->
                <LinearLayout
                    android:id="@+id/button_local_authentication"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/au9_provider_row"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="70dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/au9_icon_well">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_auth_offline" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Local profile"
                            android:textColor="#F4F6F9"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Offline · pick any name, no password"
                            android:textColor="#8A909C"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:background="@drawable/au9_keycap"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:text="3  →"
                        android:textColor="#C9CED8"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/auth_footnote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="monospace"
                    android:paddingHorizontal="4dp"
                    android:text="// credentials go straight to the provider — the launcher never sees your password"
                    android:textColor="#4F5460"
                    android:textSize="9.5sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
